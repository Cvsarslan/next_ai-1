    { label:'Payables',       val: CUR+' '+fmtN(kpi.accounts_payable||0),      icon:'fa-file-invoice',     col:'#f87171', nav:'purchase-invoices',   sub:'Due to suppliers' },
    { label:'Overdue',        val: kpi.overdue_count||0,                        icon:'fa-exclamation-circle',col:'#f59e0b', nav:'sales-invoices',     sub: CUR+' '+fmtN(kpi.overdue_amount||0) },
    { label:'Customers',      val: kpi.customers||0,                            icon:'fa-users',            col:'#22d3ee', nav:'customers',           sub:'Registered' },
  ];

  el.innerHTML = `
    <!-- Finance KPIs -->
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:9px;margin-bottom:16px">
      ${kpiCards.map(k=>`
      <div onclick="nav('${k.nav}')" style="background:${k.col}12;border:1px solid ${k.col}30;border-radius:13px;padding:13px 15px;cursor:pointer;transition:.2s"
        onmouseover="this.style.transform='translateY(-2px)';this.style.boxShadow='0 8px 20px ${k.col}20'"
