  const fd = `${yr}-${mo}-01`;
  const td = `${yr}-${mo}-${String(new Date(+yr, +mo, 0).getDate()).padStart(2, '0')}`;
  const status = window._btxnStatus !== 'All' ? window._btxnStatus : null;
