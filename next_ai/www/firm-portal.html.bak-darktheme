async function submitExpenseClaim() {
  const btn = document.getElementById('ec-btn'), msg = document.getElementById('ec-msg');
  const emp = document.getElementById('ec-emp').value;
  if (!emp) { showMsg(msg, 'Employee is required', 'err'); return; }
  const rows = document.querySelectorAll('[id^="ecr-"]');
  const expenses = [...rows].map(r => {
    const idx = r.id.replace('ecr-', '');
    return {
      expense_date: (document.getElementById('ec-edate-' + idx) || {}).value,
      expense_type: (document.getElementById('ec-etype-' + idx) || {}).value,
      description: (document.getElementById('ec-edesc-' + idx) || {}).value,
      amount: parseFloat((document.getElementById('ec-eamt-' + idx) || {}).value || 0),
    };
  }).filter(e => e.expense_type && e.amount > 0);
  if (!expenses.length) { showMsg(msg, 'Add at least one expense line with an amount', 'err'); return; }
  btn.disabled = true; btn.innerHTML = '<span class="spin"></span> Saving…';
  try {
    const res = await fc('next_ai.api.create_expense_claim', {
      employee: emp,
      posting_date: document.getElementById('ec-date').value,
      expense_approver: document.getElementById('ec-approver').value,
      remark: document.getElementById('ec-rmk').value,
      expenses: JSON.stringify(expenses),
      company: COMPANY,
    });
    showMsg(msg, `Expense Claim "${res.name}" saved! Total: ${CUR} ${fmtN(res.total_claimed_amount)}`, 'ok');
    setTimeout(() => { closePanel(); loadExpenseClaims(); }, 1300);
  } catch (e) {
    showMsg(msg, e.message, 'err');
    btn.disabled = false; btn.innerHTML = '<i class="fas fa-save"></i> Submit Claim';
  }
}

