function today() { return todayStr(); }

function addJERow() {
  const d = document.getElementById('qje-rows');
  if (!d) return;
  const r = document.createElement('div');
  r.className = 'qje-row';
  r.innerHTML = `
    <input class="qje-acc" placeholder="Account name…">
    <input type="number" class="qje-dr" value="0" min="0" style="color:#10b981">
    <input type="number" class="qje-cr" value="0" min="0" style="color:#f87171">
    <button class="btn-rm-it" onclick="this.closest('.qje-row').remove()" title="Remove"><i class="fas fa-times"></i></button>`;
  d.appendChild(r);
}

/* ── Submit: Employee ── */
async function submitQCEmployee() {
  const btn=document.getElementById('qe-btn'), msg=document.getElementById('qe-msg');
  const first=document.getElementById('qe-first').value.trim();
  const last=document.getElementById('qe-last').value.trim();
  if(!first||!last){showMsg(msg,'First and last name are required','err');return;}
  btn.disabled=true; btn.innerHTML='<span class="spin"></span> Saving…';
  try {
    const res = await fc('next_ai.api.create_employee', {
      employee_name: first + ' ' + last,
      gender: document.getElementById('qe-gender').value,
      date_of_joining: document.getElementById('qe-doj').value,
      company: document.getElementById('qe-co').value,
      department: document.getElementById('qe-dept').value,
      designation: document.getElementById('qe-desig').value,
      company_email: document.getElementById('qe-email').value,
    });
    showMsg(msg, `Employee "${res.employee_name}" (${res.name}) created!`, 'ok');
    setTimeout(closePanel, 1400);
  } catch(e) { showMsg(msg, e.message, 'err'); btn.disabled=false; btn.innerHTML='<i class="fas fa-save"></i> Create Employee'; }
}

/* ── Submit: Purchase Order ── */
async function submitQCPO() {
  const btn=document.getElementById('qpo-btn'), msg=document.getElementById('qpo-msg');
  const supplier=document.getElementById('qpo-sup').value.trim();
  const date=document.getElementById('qpo-date').value;
  if(!supplier||!date){showMsg(msg,'Supplier and date are required','err');return;}
  const items=await resolveItems('qpo-items',msg);
  if(!items) return;
  btn.disabled=true; btn.innerHTML='<span class="spin"></span> Saving…';
  try {
    const res = await fc('next_ai.api.create_purchase_order', {
      supplier,
      transaction_date: date,
      schedule_date: document.getElementById('qpo-del').value || date,
      items: JSON.stringify(items),
      company: document.getElementById('qpo-co').value,
    });
    showMsg(msg, `Purchase Order "${res.name}" saved!`, 'ok');
    setTimeout(closePanel, 1400);
  } catch(e) { showMsg(msg, e.message, 'err'); btn.disabled=false; btn.innerHTML='<i class="fas fa-save"></i> Save Draft'; }
}

