let _allEmps = [];
async function loadEmployeeList() {
  const status = (document.getElementById('emp-status-filter') || {}).value || 'Active';
  try {
    _allEmps = await fc('next_ai.api.get_employees', { status });
    renderEmployeeGrid(_allEmps);
  } catch (e) {
    const g = document.getElementById('emp-grid');
    if (g) g.innerHTML = `<div class="alert a-err">${esc(e.message)}</div>`;
  }
}

function filterEmployees() {
  const s = (document.getElementById('emp-search') || {}).value?.toLowerCase() || '';
  renderEmployeeGrid(s ? _allEmps.filter(e =>
    (e.employee_name || '').toLowerCase().includes(s) ||
    (e.department || '').toLowerCase().includes(s) ||
    (e.designation || '').toLowerCase().includes(s)
  ) : _allEmps);
}

function renderEmployeeGrid(emps) {
  const g = document.getElementById('emp-grid');
  if (!g) return;
  if (!emps.length) { g.innerHTML = '<div class="loading">No employees found.</div>'; return; }
  const colors = ['#c084fc','#60a5fa','#34d399','#fbbf24','#f87171','#a78bfa'];
  g.innerHTML = emps.map((e, i) => {
    const initials = (e.employee_name || 'E').split(' ').map(w => w[0]).join('').slice(0, 2).toUpperCase();
    const col = colors[i % colors.length];
    return `<div style="background:var(--card);border:1px solid var(--border);border-radius:14px;padding:18px;cursor:pointer;transition:.2s" onmouseover="this.style.borderColor='#7c3aed'" onmouseout="this.style.borderColor='var(--border)'" onclick="viewEmployee('${esc(e.name)}')">
      <div style="display:flex;align-items:center;gap:12px;margin-bottom:12px">
        <div style="width:46px;height:46px;border-radius:50%;background:${col}22;border:2px solid ${col};display:flex;align-items:center;justify-content:center;font-weight:800;font-size:1rem;color:${col};flex-shrink:0">${initials}</div>
        <div style="min-width:0">
          <div style="font-weight:700;font-size:.88rem;color:var(--white);white-space:nowrap;overflow:hidden;text-overflow:ellipsis">${esc(e.employee_name)}</div>
          <div style="font-size:.72rem;color:var(--muted)">${esc(e.name)}</div>
        </div>
      </div>
      <div style="font-size:.74rem;color:var(--muted);margin-bottom:4px"><i class="fas fa-building" style="width:14px;color:${col}88"></i> ${esc(e.department || '—')}</div>
      <div style="font-size:.74rem;color:var(--muted);margin-bottom:4px"><i class="fas fa-briefcase" style="width:14px;color:${col}88"></i> ${esc(e.designation || '—')}</div>
      <div style="font-size:.74rem;color:var(--muted);margin-bottom:4px"><i class="fas fa-calendar" style="width:14px;color:${col}88"></i> Joined: ${esc(e.date_of_joining || '—')}</div>
      ${e.company_email ? `<div style="font-size:.72rem;color:var(--accent);overflow:hidden;text-overflow:ellipsis"><i class="fas fa-envelope" style="width:14px"></i> ${esc(e.company_email)}</div>` : ''}
    </div>`;
  }).join('');
}

