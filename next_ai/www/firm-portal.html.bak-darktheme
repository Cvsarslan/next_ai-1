      <div style="padding:14px 16px">${content}</div>
    </div>`;
}

function rptExportCSV() {
  const d = window._lastReportData;
  if (!d) return;
  const header = d.cols.map(([h])=>h).join(',');
  const body = d.rows.map(row=>d.cols.map(([,k])=>JSON.stringify(row[k]??'')).join(',')).join('\n');
  const csv = header + '\n' + body;
  const a = document.createElement('a');
  a.href = 'data:text/csv;charset=utf-8,' + encodeURIComponent(csv);
  a.download = (d.label||'report').replace(/\s+/g,'-').toLowerCase() + '.csv';
  a.click();
}

