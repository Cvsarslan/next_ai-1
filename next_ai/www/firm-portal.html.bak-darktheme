const QC = { companies:[], suppliers:[], departments:[], asset_cats:[], projects:[], loaded:false };

async function loadQCMeta() {
  if (QC.loaded) return;
  try {
    const d = await fc('next_ai.api.get_portal_metadata', {});
    QC.companies = d.companies || [];
    QC.suppliers = d.suppliers || [];
    QC.departments = d.departments || [];
    QC.asset_cats = d.asset_categories || [];
    QC.projects = d.projects || [];
    QC.loaded = true;
  } catch (e) {}
}

function qcOpts(arr, valKey, lblKey, blank) {
  const b = blank ? '<option value="">— Select —</option>' : '';
  return b + (arr || []).map(r => `<option value="${esc(r[valKey])}">${esc(r[lblKey] || r[valKey])}</option>`).join('');
}

