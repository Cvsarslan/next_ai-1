async function impHandleFile(file) {
  if (!file) return;
  const account = document.getElementById('imp-account')?.value;
  if (!account) {
    alert('Please select a bank account first.');
    return;
  }
  const text = await file.text();
  const lines = text.split(/\r?\n/).filter(l => l.trim());
  if (lines.length < 2) { alert('CSV must have at least a header row and one data row.'); return; }

  /* Detect delimiter */
  const delim = (lines[0].split(';').length > lines[0].split(',').length) ? ';' : ',';
  const parseRow = row => {
    const result = [], re = /("([^"]|"")*"|[^,;\n]*)[,;]/g;
    let m, src = row + delim;
    while ((m = re.exec(src)) !== null) {
      let val = m[1];
      if (val.startsWith('"') && val.endsWith('"')) val = val.slice(1, -1).replace(/""/g, '"');
      result.push(val.trim());
    }
    return result;
  };
  const headers = parseRow(lines[0]);
  const dataRows = lines.slice(1).map(parseRow).filter(r => r.some(c => c));

  window._impFile = { headers, dataRows, account, filename: file.name };
  impShowMapping(headers, dataRows.slice(0, 5));
}

