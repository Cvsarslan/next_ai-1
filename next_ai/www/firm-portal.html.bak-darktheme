let _opps = [], _oppFilter = '';
const STAGES = ['Prospecting','Qualification','Needs Analysis','Value Proposition','Id. Decision Makers','Perception Analysis','Proposal/Price Quote','Negotiation/Review','Closed Won','Closed Lost'];
const STAGE_COLORS = {'Prospecting':'#60a5fa','Qualification':'#a78bfa','Needs Analysis':'#c084fc',
  'Value Proposition':'#f59e0b','Id. Decision Makers':'#fb923c','Perception Analysis':'#f87171',
  'Proposal/Price Quote':'#34d399','Negotiation/Review':'#fbbf24','Closed Won':'#4ade80','Closed Lost':'#6b7280'};

function renderCrmOpps() {
  const el = document.getElementById('sec-crm-opps');
  el.innerHTML = `
    <div class="sec-hdr">
      <div><h2><i class="fas fa-funnel-dollar" style="color:#f59e0b;margin-right:8px"></i>Opportunities</h2><p>Sales pipeline & deal tracking</p></div>
      <button class="btn-p" style="background:linear-gradient(135deg,#d97706,#b45309)" onclick="openNewOpp()"><i class="fas fa-plus"></i> New Opportunity</button>
    </div>
    <div id="opps-pipeline"><div class="loading"><span class="spin"></span> Loading…</div></div>`;
  loadOpps();
}

async function loadOpps() {
  const el = document.getElementById('opps-pipeline');
  const rows = await safeGet(() => fc('next_ai.api.get_opportunities', {}));
  _opps = rows || [];
  renderOppsPipeline(_opps);
}

function setOpportunityFilter(filter) {
  _oppFilter = _oppFilter === filter ? '' : filter;
  renderOppsPipeline(_opps);
}

function renderOppsPipeline(rows) {
  const el = document.getElementById('opps-pipeline');
  if (!el) return;
  const allRows = rows;
  rows = !_oppFilter ? rows : rows.filter(r => _oppFilter === 'open'
    ? !String(r.sales_stage||'').includes('Closed')
    : r.sales_stage === 'Closed Won');
  if (!allRows.length) {
    el.innerHTML = `<div class="loading" style="color:var(--muted)"><i class="fas fa-funnel-dollar" style="font-size:2rem;opacity:.3;display:block;margin-bottom:10px"></i>No opportunities yet. Start by converting a lead or creating one directly.</div>`;
    return;
  }

  /* Group by stage */
  const byStage = {};
  STAGES.forEach(s => byStage[s] = []);
  rows.forEach(r => { (byStage[r.sales_stage] || (byStage['Prospecting'] = byStage['Prospecting']||[])).push({...r,_i:_opps.indexOf(r)}); });
  const activeStages = STAGES.filter(s => byStage[s]?.length > 0);
  const totalValue = allRows.reduce((a,r)=>a+flt(r.opportunity_amount||0),0);

  el.innerHTML = `
    <!-- Summary bar -->
    <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:16px">
      ${[['Total Pipeline', CUR+' '+fmtN(totalValue),'#f59e0b','fa-coins'],
         ['Open Deals', allRows.filter(r=>!r.sales_stage?.includes('Closed')).length,'#60a5fa','fa-handshake'],
         ['Won Deals',   allRows.filter(r=>r.sales_stage==='Closed Won').length,'#4ade80','fa-trophy']
        ].map(([lbl,val,col,ico])=>`
      <button type="button" onclick="setOpportunityFilter('${lbl==='Open Deals'?'open':lbl==='Won Deals'?'won':''}')" style="background:rgba(255,255,255,.03);border:1px solid ${(_oppFilter===(lbl==='Open Deals'?'open':lbl==='Won Deals'?'won':''))?col:'rgba(255,255,255,.07)'};border-radius:12px;padding:12px;text-align:center;cursor:pointer;color:inherit">
        <i class="fas ${ico}" style="color:${col};margin-bottom:6px"></i>
        <div style="font-size:.68rem;color:var(--muted);margin-bottom:2px">${lbl}</div>
        <div style="font-size:.96rem;font-weight:800;color:${col}">${val}</div>
      </button>`).join('')}
    </div>
    <!-- Pipeline columns (horizontal scroll) -->
    <div style="display:flex;gap:10px;overflow-x:auto;padding-bottom:8px">
      ${activeStages.map(stage=>{
        const col = STAGE_COLORS[stage]||'#9ca3af';
        const stageRows = byStage[stage]||[];
        const stageVal = stageRows.reduce((a,r)=>a+flt(r.opportunity_amount||0),0);
        return `<div style="min-width:200px;flex-shrink:0;background:rgba(255,255,255,.02);border:1px solid rgba(255,255,255,.06);border-radius:12px;overflow:hidden">
          <div style="padding:10px 12px;background:${col}10;border-bottom:1px solid ${col}20">
            <div style="font-size:.68rem;font-weight:800;color:${col};text-transform:uppercase;letter-spacing:.5px">${stage}</div>
            <div style="font-size:.72rem;color:var(--muted);margin-top:2px">${stageRows.length} deal${stageRows.length!==1?'s':''} · ${CUR} ${fmtN(stageVal)}</div>
          </div>
          <div style="padding:8px;display:flex;flex-direction:column;gap:6px">
            ${stageRows.map(r=>`
            <div onclick="viewOpp(_opps[${r._i}])" style="background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.07);border-radius:9px;padding:10px;cursor:pointer;transition:.15s"
              onmouseover="this.style.borderColor='${col}'" onmouseout="this.style.borderColor='rgba(255,255,255,.07)'">
              <div style="font-size:.78rem;font-weight:700;color:#fff;margin-bottom:4px">${esc(r.title||r.party_name)}</div>
              <div style="font-size:.68rem;color:var(--muted)">${esc(r.party_name)}</div>
              ${r.opportunity_amount?`<div style="font-size:.78rem;font-weight:800;color:${col};margin-top:5px">${CUR} ${fmtN(r.opportunity_amount)}</div>`:''}
              ${r.expected_closing?`<div style="font-size:.62rem;color:var(--muted);margin-top:2px"><i class="fas fa-calendar" style="margin-right:3px"></i>${esc(r.expected_closing)}</div>`:''}
              <div style="font-size:.64rem;color:${col};margin-top:4px;font-weight:700">${r.probability||0}% probability</div>
            </div>`).join('')}
          </div>
        </div>`;
      }).join('')}
    </div>`;
}

function viewOpp(r) {
  const col = STAGE_COLORS[r.sales_stage]||'#f59e0b';
  openPanel('Opportunity — ' + (r.title||r.party_name), {
    subtitle: r.party_name, icon: 'fas fa-funnel-dollar',
    iconBg: 'linear-gradient(135deg,rgba(217,119,6,.25),rgba(180,83,9,.15))', iconBorder: 'rgba(217,119,6,.35)'
  });
  document.getElementById('p-body').innerHTML = `
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:16px">
      ${[['Party', r.party_name,'#60a5fa','fa-user'],['Type',r.opportunity_type||'Sales','#a78bfa','fa-tag'],
         ['Amount',r.opportunity_amount?CUR+' '+fmtN(r.opportunity_amount):'—','#4ade80','fa-coins'],
         ['Probability',(r.probability||0)+'%','#f59e0b','fa-percent'],
         ['Closing',r.expected_closing||'—','#34d399','fa-calendar'],
         ['Stage',r.sales_stage,'#fb923c','fa-flag'],
        ].map(([lbl,val,c,ico])=>`
        <div style="background:rgba(255,255,255,.03);border:1px solid rgba(255,255,255,.07);border-radius:10px;padding:10px 12px">
          <div style="font-size:.6rem;color:var(--muted);margin-bottom:3px;text-transform:uppercase">
            <i class="fas ${ico}" style="color:${c};margin-right:4px;font-size:.55rem"></i>${lbl}</div>
          <div style="font-size:.82rem;font-weight:700;color:#fff">${esc(String(val))}</div>
        </div>`).join('')}
    </div>
    <div style="margin-bottom:10px">
      <div style="font-size:.68rem;color:var(--muted);margin-bottom:8px;text-transform:uppercase;letter-spacing:.5px">Move Stage</div>
      <div style="display:flex;flex-wrap:wrap;gap:5px">
        ${STAGES.map(s=>{const c=STAGE_COLORS[s]||'#9ca3af';return `
        <button onclick="setOppStage('${esc(r.name)}','${esc(s)}')"
          style="font-size:.65rem;padding:4px 10px;border-radius:20px;cursor:pointer;font-weight:700;
          background:${s===r.sales_stage?c+'25':'rgba(255,255,255,.05)'};
          border:1px solid ${s===r.sales_stage?c:'rgba(255,255,255,.1)'};
          color:${s===r.sales_stage?c:'var(--muted)'}">${s}</button>`;}).join('')}
      </div>
    </div>`;
  document.getElementById('p-foot').innerHTML = `<button class="btn-s" onclick="closePanel()">Close</button>`;
}

async function setOppStage(name, stage) {
  const prob = {'Prospecting':20,'Qualification':25,'Needs Analysis':30,'Value Proposition':40,
    'Id. Decision Makers':50,'Perception Analysis':60,'Proposal/Price Quote':70,
    'Negotiation/Review':85,'Closed Won':100,'Closed Lost':0}[stage]||null;
  await fc('next_ai.api.update_opportunity_stage', { name, sales_stage: stage, probability: prob });
  closePanel(); loadOpps();
}

