function _miniOverdue(ov) {
  if (!ov.length) return `<div style="color:#4ade80;font-size:.7rem;display:flex;align-items:center;gap:5px"><i class="fas fa-check-circle"></i> All clear!</div>`;
  return ov.slice(0,4).map(r=>`
    <div style="display:flex;justify-content:space-between;align-items:center;padding:4px 0;border-bottom:1px solid rgba(255,255,255,.04)">
      <div style="min-width:0;flex:1">
        <div style="font-size:.67rem;color:#fff;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">${esc(r.customer_name||'')}</div>
        <div style="font-size:.56rem;color:#f87171">${esc(r.due_date||'')} overdue</div>
      </div>
      <div style="font-size:.68rem;font-weight:800;color:#f59e0b;margin-left:6px;flex-shrink:0">${fmtN(r.outstanding_amount)}</div>
    </div>`).join('');
}

function _miniTopCustomers(tc) {
  if (!tc.length) return `<div style="color:var(--muted);font-size:.7rem">No data yet.</div>`;
  const max = Math.max(1, ...tc.map(c=>flt(c.total)));
  return tc.slice(0,4).map(c => {
    const pct = Math.round(flt(c.total)/max*100);
    const ini = (c.customer_name||'?').split(' ').map(w=>w[0]).slice(0,2).join('').toUpperCase();
    return `<div style="display:flex;align-items:center;gap:8px;margin-bottom:8px">
      <div style="width:26px;height:26px;border-radius:7px;background:linear-gradient(135deg,#4f46e5,#818cf8);display:flex;align-items:center;justify-content:center;font-size:.54rem;font-weight:900;color:#fff;flex-shrink:0">${esc(ini)}</div>
      <div style="flex:1;min-width:0">
        <div style="display:flex;justify-content:space-between;margin-bottom:2px">
          <span style="font-size:.68rem;color:#fff;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:100px">${esc(c.customer_name||c.name)}</span>
          <span style="font-size:.67rem;font-weight:800;color:#6366f1;flex-shrink:0;margin-left:4px">${fmtN(c.total)}</span>
        </div>
        <div style="height:3px;background:rgba(255,255,255,.06);border-radius:2px">
          <div style="height:100%;width:${pct}%;background:linear-gradient(90deg,#4f46e5,#818cf8);border-radius:2px"></div>
        </div>
      </div>
    </div>`;
  }).join('');
}

function _miniRecentInvoices(rec) {
  if (!rec.length) return `<div style="color:var(--muted);font-size:.74rem">No invoices yet.</div>`;
  return `<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:6px">
    ${rec.map(r => {
      const isPaid = flt(r.outstanding_amount||0) === 0;
      const isOver = r.outstanding_amount > 0 && r.due_date && r.due_date < todayStr();
      const sCol = isPaid ? '#4ade80' : isOver ? '#f87171' : '#f59e0b';
      const sTxt = isPaid ? 'Paid' : isOver ? 'Overdue' : 'Pending';
      return `<div style="display:flex;align-items:center;justify-content:space-between;padding:8px 10px;background:rgba(255,255,255,.02);border:1px solid rgba(255,255,255,.06);border-radius:9px">
        <div style="min-width:0;flex:1">
          <div style="font-size:.72rem;color:#fff;font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">${esc(r.customer_name||'')}</div>
          <div style="font-size:.6rem;color:var(--muted)">${esc(r.name)} · ${esc(r.posting_date||'')}</div>
        </div>
        <div style="text-align:right;flex-shrink:0;margin-left:10px">
          <div style="font-size:.72rem;font-weight:800;color:#fff">${CUR} ${fmtN(r.grand_total)}</div>
          <div style="font-size:.6rem;color:${sCol};font-weight:700">${sTxt}</div>
        </div>
      </div>`;
    }).join('')}
  </div>`;
}

