      <input placeholder="Item description *" id="id-${idx}" oninput="onItemInput(this,${idx})" list="idl-${idx}">
      <datalist id="idl-${idx}"></datalist>
      <label class="create-toggle">
        <input type="checkbox" id="ic-${idx}" onchange="onCreateToggle(${idx})"> Create new item code
      </label>
      <input id="icode-${idx}" placeholder="Item code (auto from description if blank)" style="display:none;font-size:.72rem;margin-top:4px;">
    </div>
    <input placeholder="Qty" type="number" min="0.01" step="any" value="1" id="iqty-${idx}" oninput="calcTotals()">
    <input placeholder="Rate" type="number" min="0" step="any" value="0" id="irate-${idx}" oninput="calcTotals()">
    <select id="iuom-${idx}" style="padding:6px 4px;font-size:.72rem;background:var(--card);border:1px solid var(--border);color:var(--text);border-radius:5px;outline:none;">
      <option>Nos</option><option>Kg</option><option>Ltr</option><option>Meter</option><option>Box</option><option>Pcs</option>
    </select>
    <button class="btn-rm-it" onclick="document.getElementById('ir-${idx}').remove();calcTotals()">×</button>`;
  wrap.appendChild(div);
  // Fill datalist after prefetch
