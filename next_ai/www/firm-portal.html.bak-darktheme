          <div style="font-size:.6rem;color:var(--muted);margin-bottom:3px;text-transform:uppercase">
            <i class="fas ${ico}" style="color:${col};margin-right:4px;font-size:.55rem"></i>${lbl}</div>
          <div style="font-size:.82rem;font-weight:700;color:#fff">${esc(String(val))}</div>
        </div>`).join('')}
    </div>
    <!-- Depreciation progress -->
    <div style="background:rgba(245,158,11,.06);border:1px solid rgba(245,158,11,.15);border-radius:12px;padding:12px;margin-bottom:14px">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px">
        <span style="font-size:.72rem;font-weight:700;color:#f59e0b">Depreciation Progress</span>
        <span style="font-size:.72rem;color:#f59e0b;font-weight:800">${deprPct}%</span>
      </div>
      <div style="height:8px;background:rgba(255,255,255,.08);border-radius:8px">
        <div style="height:100%;width:${deprPct}%;background:linear-gradient(90deg,#f59e0b,#d97706);border-radius:8px;transition:width .5s"></div>
      </div>
    </div>
    <!-- Depreciation schedule table -->
    ${schedule?.length ? `
    <div style="font-size:.72rem;font-weight:800;color:var(--muted);text-transform:uppercase;letter-spacing:.5px;margin-bottom:8px">Depreciation Schedule</div>
