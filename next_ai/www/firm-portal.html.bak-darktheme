async function submitMarkAttendance() {
  const btn = document.getElementById('ma-btn'), msg = document.getElementById('ma-msg');
  btn.disabled = true; btn.innerHTML = '<span class="spin"></span> Saving…';
  try {
    const res = await fc('next_ai.api.mark_attendance', {
      employee: document.getElementById('ma-emp').value,
      attendance_date: document.getElementById('ma-date').value,
      status: document.getElementById('ma-status').value,
      in_time: document.getElementById('ma-in').value,
      out_time: document.getElementById('ma-out').value,
    });
    showMsg(msg, `Attendance marked: ${res.status} (${res.name})`, 'ok');
    setTimeout(() => { closePanel(); loadAttendance(); }, 1200);
  } catch (e) {
    showMsg(msg, e.message, 'err');
    btn.disabled = false; btn.innerHTML = '<i class="fas fa-check"></i> Mark Attendance';
  }
}

