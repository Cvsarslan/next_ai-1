function rptSetPeriod(idx) {
  const now = new Date(); const yr=now.getFullYear(); const mo=now.getMonth();
  let fd, td;
  if (idx===0) { fd=new Date(yr,mo,1); td=new Date(yr,mo+1,0); }
  else if (idx===1) { const q=Math.floor(mo/3); fd=new Date(yr,q*3,1); td=new Date(yr,q*3+3,0); }
  else { fd=new Date(yr,0,1); td=new Date(yr,11,31); }
  const fmt = d => d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0');
  document.getElementById('rpt-from').value = fmt(fd);
  document.getElementById('rpt-to').value   = fmt(td);
}

async function runReport(reportId) {
  const card = REPORT_CARDS.find(c=>c.id===reportId);
  const fd = document.getElementById('rpt-from')?.value;
  const td = document.getElementById('rpt-to')?.value;
  const el = document.getElementById('rpt-result');
  el.innerHTML = `<div style="background:rgba(255,255,255,.03);border:1px solid rgba(255,255,255,.07);border-radius:14px;padding:20px;text-align:center">
    <span class="spin" style="margin:0 auto 10px;display:block;width:24px;height:24px"></span>
    <div style="font-size:.8rem;color:var(--muted)">Generating ${card?.label||reportId}…</div>
  </div>`;
  try {
    const res = await fcGet('next_ai.api.get_portal_report', { report_type: reportId, from_date: fd, to_date: td });
    renderReportResult(res, card);
  } catch(e) {
    el.innerHTML = `<div style="background:rgba(244,63,94,.08);border:1px solid rgba(244,63,94,.2);border-radius:12px;padding:14px;color:#f87171;font-size:.8rem">
      <i class="fas fa-exclamation-triangle" style="margin-right:6px"></i>${esc(e.message||'Report failed')}
    </div>`;
  }
}

function reportRowsVisual(res, color) {
  const rows = res.rows || [];
  if (!rows.length) return '';
  const valueKeys = ['outstanding','total','net_pay','total_claimed_amount','net_asset_value','gross_purchase_amount','billed','net'];
  const valueKey = valueKeys.find(key => rows.some(row => flt(row[key]) !== 0));
  if (!valueKey) return '';
  const labelKeys = ['party_name','employee_name','asset_name','period','name'];
  const labelKey = labelKeys.find(key => rows.some(row => row[key]));
  if (!labelKey) return '';
  const data = rows.slice(0, 8);
  const max = Math.max(1, ...data.map(row => Math.abs(flt(row[valueKey]))));
  return `<div style="display:grid;grid-template-columns:repeat(${Math.min(data.length,8)},minmax(34px,1fr));gap:8px;height:145px;align-items:end;margin:4px 0 18px;padding:10px 8px 0;border-bottom:1px solid var(--border)">
    ${data.map(row=>{
      const val = flt(row[valueKey]);
      const height = Math.max(5,Math.round(Math.abs(val)/max*96));
      return `<div title="${esc(String(row[labelKey]||''))}: ${CUR} ${fmtN(val)}" style="height:100%;display:flex;flex-direction:column;justify-content:flex-end;align-items:center;gap:5px;min-width:0">
        <span style="font-size:.53rem;color:${color};font-weight:700">${fmtN(val)}</span>
        <div style="width:min(34px,76%);height:${height}px;background:linear-gradient(180deg,${color},color-mix(in srgb,${color} 55%,#000));border-radius:5px 5px 2px 2px"></div>
        <span style="max-width:100%;font-size:.52rem;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis">${esc(String(row[labelKey]||''))}</span>
      </div>`;
    }).join('')}
  </div>`;
}

