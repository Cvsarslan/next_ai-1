async function ecOcrFile(file) {
  if (!file) return;
  const statusEl = document.getElementById('ec-ocr-status');
  const dropzone  = document.getElementById('ec-ocr-dropzone');
  if (!statusEl) return;

  /* Show preview thumbnail + scanning state */
  const previewUrl = URL.createObjectURL(file);
  statusEl.style.display = 'block';
  statusEl.innerHTML = `
    <div style="background:rgba(99,102,241,.08);border:1px solid rgba(99,102,241,.2);border-radius:14px;padding:14px;display:flex;align-items:center;gap:14px">
      <img src="${previewUrl}" style="width:64px;height:64px;object-fit:cover;border-radius:10px;border:1px solid rgba(255,255,255,.1);flex-shrink:0">
      <div style="flex:1;min-width:0">
        <div style="font-size:.82rem;font-weight:700;color:#fff;margin-bottom:4px">${esc(file.name)}</div>
        <div style="display:flex;align-items:center;gap:8px;color:#a78bfa;font-size:.73rem">
          <span class="spin" style="width:12px;height:12px;border-width:2px;border-color:#a78bfa rgba(167,139,250,.2) rgba(167,139,250,.2) rgba(167,139,250,.2);flex-shrink:0"></span>
          Claude AI is scanning your receipt…
        </div>
      </div>
    </div>`;

  if (dropzone) {
    dropzone.style.opacity = '0.5';
    dropzone.style.pointerEvents = 'none';
  }

  try {
    /* Read file as base64 */
    const base64 = await new Promise((resolve, reject) => {
      const reader = new FileReader();
      reader.onload  = e => resolve(e.target.result);
      reader.onerror = reject;
      reader.readAsDataURL(file);
    });

    const result = await fc('next_ai.api.ocr_expense_receipt', {
      image_base64: base64,
      filename: file.name
    });

    if (result.ok && result.data) {
      const d = result.data;
      ecOcrApply(d, previewUrl, file.name);
    } else {
      statusEl.innerHTML = `
        <div style="background:rgba(244,63,94,.08);border:1px solid rgba(244,63,94,.2);border-radius:12px;padding:12px 14px;font-size:.78rem;color:#f87171">
          <i class="fas fa-exclamation-triangle" style="margin-right:6px"></i>
          Could not extract data from this image. Please fill in the details manually.
        </div>`;
      if (dropzone) { dropzone.style.opacity = '1'; dropzone.style.pointerEvents = ''; }
    }
  } catch(e) {
    statusEl.innerHTML = `
      <div style="background:rgba(244,63,94,.08);border:1px solid rgba(244,63,94,.2);border-radius:12px;padding:12px 14px;font-size:.78rem;color:#f87171">
        <i class="fas fa-exclamation-triangle" style="margin-right:6px"></i>${esc(e.message || 'OCR failed')}
      </div>`;
    if (dropzone) { dropzone.style.opacity = '1'; dropzone.style.pointerEvents = ''; }
  }
}

function ecOcrApply(d, previewUrl, fileName) {
  const statusEl = document.getElementById('ec-ocr-status');
  const dropzone  = document.getElementById('ec-ocr-dropzone');

  /* Stash extracted data globally so onclick="ecOcrFill()" can read it */
  window._lastOcrData = d;

  /* Map extracted category to available expense types */
  const etypes = window._expenseTypes || [];
  const catLower = (d.category || '').toLowerCase();
  const matchedType = etypes.find(t => t.name.toLowerCase().includes(catLower) || catLower.includes(t.name.toLowerCase()))
                   || etypes.find(t => {
                       const kws = {travel:['travel','transport','taxi','uber','flight','fuel','petrol'],
                                    food:['food','meal','restaurant','lunch','dinner','breakfast','cafe'],
                                    accommodation:['hotel','accommodation','stay','lodging'],
                                    communication:['phone','mobile','internet','telecom'],
                                    office:['office','stationery','supplies']};
                       return Object.entries(kws).some(([k,v]) => t.name.toLowerCase().includes(k) && v.some(w => catLower.includes(w)));
                   });
  window._lastOcrMatchedType = matchedType ? matchedType.name : null;

  /* Show success card with extracted data */
  const amount = parseFloat(d.amount) || 0;
  const currency = d.currency || 'AED';
  statusEl.innerHTML = `
    <div style="background:linear-gradient(135deg,rgba(16,185,129,.1),rgba(5,150,105,.06));border:1px solid rgba(16,185,129,.25);border-radius:14px;overflow:hidden">
      <div style="padding:12px 14px;border-bottom:1px solid rgba(16,185,129,.15);display:flex;align-items:center;gap:10px">
        <img src="${previewUrl}" style="width:48px;height:48px;object-fit:cover;border-radius:9px;border:1px solid rgba(255,255,255,.1);flex-shrink:0">
        <div style="flex:1">
          <div style="display:flex;align-items:center;gap:6px;margin-bottom:2px">
            <i class="fas fa-magic" style="color:#10b981;font-size:.78rem"></i>
            <span style="font-size:.78rem;font-weight:800;color:#10b981">Receipt Scanned Successfully</span>
          </div>
          <div style="font-size:.68rem;color:var(--muted)">${esc(fileName)}</div>
        </div>
        <button onclick="ecOcrClear()" style="background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.1);color:var(--muted);width:26px;height:26px;border-radius:6px;cursor:pointer;font-size:.7rem">
          <i class="fas fa-times"></i>
        </button>
      </div>
      <!-- Extracted fields grid -->
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:0;padding:12px 14px;gap:10px">
        ${[
          ['Vendor / Merchant', d.vendor || '—', 'fa-store', '#60a5fa'],
          ['Date', d.date || '—', 'fa-calendar', '#a78bfa'],
          ['Amount', amount ? currency + ' ' + amount.toFixed(2) : '—', 'fa-coins', '#10b981'],
          ['Category', d.category || '—', 'fa-tag', '#f59e0b'],
        ].map(([lbl,val,ico,col]) => `
          <div style="background:${col}0a;border:1px solid ${col}20;border-radius:9px;padding:10px 12px">
            <div style="font-size:.58rem;font-weight:700;text-transform:uppercase;letter-spacing:.4px;color:var(--muted);margin-bottom:4px">
              <i class="fas ${ico}" style="color:${col};margin-right:4px;font-size:.6rem"></i>${lbl}
            </div>
            <div style="font-size:.84rem;font-weight:700;color:#fff">${esc(String(val))}</div>
