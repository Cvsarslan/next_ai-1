function impParseDate(raw, fmt) {
  const s = (raw || '').trim();
  if (!s) return null;
  let d, m, y;
  if (fmt === 'DD/MM/YYYY') { [d, m, y] = s.split('/'); }
  else if (fmt === 'MM/DD/YYYY') { [m, d, y] = s.split('/'); }
  else if (fmt === 'YYYY-MM-DD') { [y, m, d] = s.split('-'); }
  else if (fmt === 'DD-MM-YYYY') { [d, m, y] = s.split('-'); }
  else if (fmt === 'DD.MM.YYYY') { [d, m, y] = s.split('.'); }
  else if (fmt === 'M/D/YYYY')   { [m, d, y] = s.split('/'); }
  else { return s; }
  if (!y || !m || !d) return s;
  return `${y.padStart(4,'0')}-${String(m).padStart(2,'0')}-${String(d).padStart(2,'0')}`;
}

