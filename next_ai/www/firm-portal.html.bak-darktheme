  if (el2) el2.innerHTML = '<div class="loading"><span class="spin"></span></div>';
  const detail = document.getElementById('hr-detail');
  if (detail) detail.style.display = 'none';

  try {
    const d = await fc('next_ai.api.get_hr_dashboard', { company: COMPANY, from_date: from, to_date: to });
