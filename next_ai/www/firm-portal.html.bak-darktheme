    const res = await fc('next_ai.api.create_sales_invoice', {
      customer, posting_date: date,
      due_date: document.getElementById('si-due').value || null,
      items: JSON.stringify(items), company: COMPANY,
      remarks: document.getElementById('si-rmk').value,
      currency: cur,
      conversion_rate: cur !== CUR ? rate : 1,
