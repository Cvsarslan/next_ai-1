  Interested:'#34d399', Converted:'#4ade80', 'Do Not Contact':'#f87171' };

function renderLeadsTable(rows) {
  const el = document.getElementById('leads-list');
  if (!el) return;
  if (!rows.length) {
    el.innerHTML = `<div class="loading" style="color:var(--muted)"><i class="fas fa-bullseye" style="font-size:2rem;opacity:.3;display:block;margin-bottom:10px"></i>No leads found. Create your first lead.</div>`;
    return;
  }
  el.innerHTML = `<div class="tbl-wrap"><table class="tbl"><thead><tr>
    <th>Name</th><th>Company</th><th>Email / Phone</th><th>Source</th><th>Status</th><th></th>
  </tr></thead><tbody>${rows.map((r,i)=>{
    const col = LEAD_STATUS_COLORS[r.status] || '#9ca3af';
    return `<tr style="cursor:pointer" onclick="viewLead(_leads[${i}])"
      onmouseover="this.style.background='rgba(251,113,133,.05)'" onmouseout="this.style.background=''">
