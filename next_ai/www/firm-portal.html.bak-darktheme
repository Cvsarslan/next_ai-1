function onItemInput(input, idx) {
  // If matches existing item, auto-fill
  const item = _C.items.find(i => i.item_name === input.value || i.name === input.value);
  if (item) {
    const codeEl = document.getElementById('icode-' + idx);
    if (codeEl && !document.getElementById('ic-' + idx).checked) {
      codeEl.value = item.name;
    }
  }
}

function onCreateToggle(idx) {
  const cb = document.getElementById('ic-' + idx);
  const codeEl = document.getElementById('icode-' + idx);
  if (cb && codeEl) codeEl.style.display = cb.checked ? 'block' : 'none';
}

async function resolveItems(containerId, msgEl) {
  const wrap = document.getElementById(containerId);
  const rows = wrap.querySelectorAll('.it-row');
  if (!rows.length) { showMsg(msgEl, 'Add at least one item', 'err'); return null; }
  const items = [];
  for (const row of rows) {
    const idx = row.id.replace('ir-', '');
    const desc = (document.getElementById('id-' + idx) || {}).value?.trim();
    if (!desc) continue;
    const createNew = (document.getElementById('ic-' + idx) || {}).checked;
    const manualCode = (document.getElementById('icode-' + idx) || {}).value?.trim();
    const qty = parseFloat((document.getElementById('iqty-' + idx) || {}).value || 1) || 1;
    const rate = parseFloat((document.getElementById('irate-' + idx) || {}).value || 0) || 0;
    const uom = (document.getElementById('iuom-' + idx) || {}).value || 'Nos';

    // Check if existing item by name
    const existing = _C.items.find(i => i.item_name === desc || i.name === desc);
    if (existing && !createNew) {
      items.push({ item_code: existing.name, item_name: existing.item_name || existing.name, qty, rate, uom });
    } else if (createNew || !existing) {
      // Need to create or get item
      try {
        showMsg(msgEl, `Resolving item: ${desc}…`, 'ok');
        const res = await fc('next_ai.api.get_or_create_item', {
          item_name: desc,
          item_code: manualCode || null,
          uom,
        });
        _C.prefetched = false; // invalidate cache
        items.push({ item_code: res.item_code, item_name: desc, qty, rate, uom });
      } catch (e) {
        showMsg(msgEl, `Failed to create item "${desc}": ${e.message}`, 'err');
        return null;
      }
    }
  }
  if (!items.length) { showMsg(msgEl, 'Add at least one valid item', 'err'); return null; }
  return items;
}

function calcTotals() {
  const wrap = document.querySelector('.it-wrap');
  if (!wrap) return;
  const totBlk = document.getElementById('si-tot');
  let sub = 0;
  wrap.querySelectorAll('.it-row').forEach(row => {
    const idx = row.id.replace('ir-', '');
    const qty = parseFloat((document.getElementById('iqty-' + idx) || {}).value || 0);
    const rate = parseFloat((document.getElementById('irate-' + idx) || {}).value || 0);
    sub += qty * rate;
  });
  if (totBlk) {
    totBlk.style.display = 'block';
    const cur = document.getElementById('si-cur') ? document.getElementById('si-cur').value : CUR;
    set('tot-sub', cur + ' ' + fmtN(sub));
    set('tot-tot', cur + ' ' + fmtN(sub));
  }
}

