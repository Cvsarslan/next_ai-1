async function submitLeave() {
  const btn = document.getElementById('lv-btn'), msg = document.getElementById('lv-msg');
  const emp = document.getElementById('lv-emp').value;
  const ltype = document.getElementById('lv-type').value;
  const from = document.getElementById('lv-from').value;
  const to = document.getElementById('lv-to').value;
  if (!emp || !ltype || !from || !to) { showMsg(msg, 'Employee, type and dates are required', 'err'); return; }
  btn.disabled = true; btn.innerHTML = '<span class="spin"></span> Submitting…';
  try {
    const half = document.getElementById('lv-half').value;
    const res = await fc('next_ai.api.apply_leave', {
      employee: emp, leave_type: ltype, from_date: from, to_date: to,
      reason: document.getElementById('lv-reason').value,
      half_day: half,
      half_day_date: half === '1' ? document.getElementById('lv-hdate').value : null,
    });
    showMsg(msg, `Leave application "${res.name}" submitted (${res.total_leave_days} days)!`, 'ok');
    setTimeout(() => { closePanel(); loadLeaveData(); }, 1300);
  } catch (e) {
    showMsg(msg, e.message, 'err');
    btn.disabled = false; btn.innerHTML = '<i class="fas fa-paper-plane"></i> Submit Application';
  }
}

