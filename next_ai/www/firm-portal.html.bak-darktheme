async function submitNewAsset() {
  const name = document.getElementById('ast-name')?.value?.trim();
  const cat  = document.getElementById('ast-cat')?.value?.trim();
  const date = document.getElementById('ast-date')?.value;
  const amt  = document.getElementById('ast-amt')?.value;
  if (!name||!cat||!date||!amt) { showMsg(document.getElementById('ast-msg'),'All fields required','err'); return; }
  const btn = document.getElementById('ast-btn');
  if (btn) { btn.disabled=true; btn.innerHTML='<span class="spin"></span> Creating…'; }
  try {
    await fc('next_ai.api.create_asset', { asset_name:name, asset_category:cat, purchase_date:date,
      gross_purchase_amount:amt, location:document.getElementById('ast-loc')?.value||'' });
    closePanel(); loadAssets();
  } catch(e) {
    if (btn) { btn.disabled=false; btn.innerHTML='<i class="fas fa-save"></i> Create Asset'; }
    showMsg(document.getElementById('ast-msg'), e.message||'Failed', 'err');
  }
}

