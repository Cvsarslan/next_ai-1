    });
    const cnt = res.employee_count || 0;
    document.getElementById('pr-result').innerHTML = `
      <div style="background:rgba(52,211,153,.1);border:1px solid rgba(52,211,153,.25);border-radius:14px;padding:18px 20px">
        <div style="display:flex;align-items:center;gap:12px;margin-bottom:12px">
