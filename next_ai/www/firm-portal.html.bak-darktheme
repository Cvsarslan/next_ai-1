let _attendanceRows = [], _attendanceFilter = '';
const _attendanceStatuses = ['Present', 'Absent', 'Half Day', 'On Leave', 'Work From Home'];

function renderAttendance() {
  const el = document.getElementById('sec-attendance');
  const now = new Date();
  const y = now.getFullYear(), m = String(now.getMonth() + 1).padStart(2, '0');
  el.innerHTML = `
    <div class="sec-hdr">
      <div><h2><i class="fas fa-calendar-check" style="color:#10b981;margin-right:8px"></i>Attendance</h2><p>Monthly attendance log</p></div>
      <div class="btn-row">
        <input id="att-from" type="date" value="${y}-${m}-01" style="background:#131926;border:1px solid var(--border);color:var(--text);padding:7px 10px;border-radius:7px;font-size:.8rem;outline:none">
        <input id="att-to" type="date" value="${today()}" style="background:#131926;border:1px solid var(--border);color:var(--text);padding:7px 10px;border-radius:7px;font-size:.8rem;outline:none">
        <button class="btn-s" onclick="loadAttendance()"><i class="fas fa-sync-alt"></i> Refresh</button>
        <button class="btn-p" style="background:linear-gradient(135deg,#7c3aed,#6d28d9)" onclick="openMarkAttendance()"><i class="fas fa-plus"></i> Mark Attendance</button>
      </div>
    </div>
    <div id="att-summary" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(120px,1fr));gap:10px;margin-bottom:16px"></div>
    <div class="tbl-card"><div class="tbl-wrap" id="att-tbl"><div class="loading"><span class="spin"></span></div></div></div>`;
  loadAttendance();
}

async function loadAttendance() {
  try {
    const from = document.getElementById('att-from').value;
    const to = document.getElementById('att-to').value;
    const rows = await fc('next_ai.api.get_attendance_log', { from_date: from, to_date: to });
    const el = document.getElementById('att-tbl');
    if (!el) return;

    _attendanceRows = rows || [];

    // Summary counts
    const sm = {};
    _attendanceRows.forEach(r => sm[r.status] = (sm[r.status] || 0) + 1);
    const statColors = {Present:'#34d399',Absent:'#f87171','Half Day':'#fbbf24','On Leave':'#c084fc','Work From Home':'#60a5fa'};
    renderAttendanceSummary(sm, statColors);
    renderAttendanceRecords(statColors);
  } catch (e) {
    const el = document.getElementById('att-tbl');
    if (el) el.innerHTML = `<div class="alert a-err">${esc(e.message)}</div>`;
  }
}

function setAttendanceFilter(status) {
  _attendanceFilter = _attendanceFilter === status ? '' : status;
  const counts = {};
  _attendanceRows.forEach(row => counts[row.status] = (counts[row.status] || 0) + 1);
  const colors = {Present:'#34d399',Absent:'#f87171','Half Day':'#fbbf24','On Leave':'#c084fc','Work From Home':'#60a5fa'};
  renderAttendanceSummary(counts, colors);
  renderAttendanceRecords(colors);
}

function renderAttendanceSummary(counts, statColors) {
  const sumEl = document.getElementById('att-summary');
  if (!sumEl) return;
  sumEl.innerHTML = _attendanceStatuses.filter(status => counts[status] || _attendanceFilter === status).map(status => {
    const color = statColors[status] || '#64748b';
    const selected = _attendanceFilter === status;
    return `<button type="button" aria-pressed="${selected}" onclick="setAttendanceFilter('${status}')"
      style="text-align:left;background:var(--card);border:1px solid ${selected ? color : 'var(--border)'};border-radius:10px;padding:12px;border-left:3px solid ${color};cursor:pointer;box-shadow:${selected ? `0 0 0 2px ${color}22,0 8px 20px ${color}18` : 'none'};transform:${selected ? 'translateY(-2px)' : 'none'};transition:.18s">
      <div style="font-size:.62rem;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.6px">${status}</div>
      <div style="font-size:1.4rem;font-weight:800;color:${color};margin-top:3px">${counts[status] || 0}</div>
    </button>`;
  }).join('');
}

function renderAttendanceRecords(statColors) {
  const el = document.getElementById('att-tbl');
  if (!el) return;
  const rows = _attendanceFilter ? _attendanceRows.filter(row => row.status === _attendanceFilter) : _attendanceRows;
  if (!rows.length) {
    el.innerHTML = `<div class="loading">No ${_attendanceFilter ? esc(_attendanceFilter.toLowerCase()) + ' ' : ''}attendance records for this period.${_attendanceFilter ? ' <button class="btn-s btn-sm" onclick="setAttendanceFilter(\'' + _attendanceFilter + '\')">Clear filter</button>' : ''}</div>`;
    return;
  }
  el.innerHTML = `${_attendanceFilter ? `<div style="display:flex;align-items:center;justify-content:space-between;padding:10px 14px;border-bottom:1px solid var(--border);font-size:.72rem"><strong>Showing ${rows.length} ${esc(_attendanceFilter)} record${rows.length === 1 ? '' : 's'}</strong><button class="btn-s btn-sm" onclick="setAttendanceFilter('${_attendanceFilter}')"><i class="fas fa-times"></i> Clear filter</button></div>` : ''}<table class="mt"><thead><tr><th>Employee</th><th>Date</th><th>Status</th><th>In Time</th><th>Out Time</th><th>Hours</th><th>Dept</th></tr></thead><tbody>
      ${rows.map(r => {
        const col = statColors[r.status] || '#64748b';
        return `<tr>
          <td><strong style="font-size:.8rem">${esc(r.employee_name || r.employee)}</strong></td>
          <td style="color:var(--muted)">${esc(r.attendance_date)}</td>
          <td><span class="tag" style="background:${col}18;color:${col}">${esc(r.status)}</span></td>
          <td style="color:var(--muted);font-size:.78rem">${esc(r.in_time || '—')}</td>
          <td style="color:var(--muted);font-size:.78rem">${esc(r.out_time || '—')}</td>
          <td style="color:var(--muted);font-size:.78rem">${r.working_hours ? parseFloat(r.working_hours).toFixed(1) + 'h' : '—'}</td>
          <td style="color:var(--muted);font-size:.78rem">${esc(r.department || '—')}</td>
        </tr>`;
      }).join('')}
    </tbody></table>`;
}

async function openMarkAttendance() {
  const emps = await safeGet(() => fc('next_ai.api.get_employees', { status: 'Active' }));
  openPanel('Mark Attendance');
  document.getElementById('p-body').innerHTML = `
    <div class="fg"><label>Employee *</label>
      <select id="ma-emp">${emps.map(e=>`<option value="${esc(e.name)}">${esc(e.employee_name)} (${esc(e.name)})</option>`).join('')}</select>
    </div>
    <div class="fg-row">
      <div class="fg"><label>Date *</label><input id="ma-date" type="date" value="${today()}"></div>
      <div class="fg"><label>Status *</label>
        <select id="ma-status">
          <option>Present</option><option>Absent</option><option>Half Day</option>
          <option>On Leave</option><option>Work From Home</option>
