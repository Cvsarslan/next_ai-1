async function submitCustomer(isEdit, existingName) {
  const btn = document.getElementById('cf-btn');
  const msg = document.getElementById('cf-msg');
  const name = document.getElementById('cf-name').value.trim();
  if (!name) { showMsg(msg, 'Customer name is required', 'err'); return; }
  btn.disabled = true; btn.innerHTML = '<span class="spin"></span> Saving…';
  try {
    if (isEdit) {
      await fc('next_ai.api.update_customer', {
        customer_name: existingName,
        customer_type: document.getElementById('cf-type').value,
        mobile_no: document.getElementById('cf-mobile').value,
        email_id: document.getElementById('cf-email').value,
        tax_id: document.getElementById('cf-tax').value,
      });
      showMsg(msg, 'Customer updated!', 'ok');
    } else {
      const res = await fc('next_ai.api.create_customer', {
        customer_name: name,
        customer_type: document.getElementById('cf-type').value,
        mobile_no: document.getElementById('cf-mobile').value,
        email_id: document.getElementById('cf-email').value,
        tax_id: document.getElementById('cf-tax').value,
      });
      showMsg(msg, `Customer "${res.customer_name}" created!`, 'ok');
    }
    _C.prefetched = false;
    _portalInsights = null;
    setTimeout(() => { closePanel(); loadCustomerList(); loadCustomerInsights(); }, 1200);
  } catch (e) { showMsg(msg, e.message, 'err'); btn.disabled = false; btn.innerHTML = '<i class="fas fa-save"></i> Save'; }
}

