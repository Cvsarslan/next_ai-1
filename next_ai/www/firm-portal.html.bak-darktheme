async function fetchRate() {
  const cur = document.getElementById('si-cur').value;
  if (cur === CUR) return;
  const rateInput = document.getElementById('si-rate');
  const rateTxt = document.getElementById('si-rate-txt');
  rateTxt.innerHTML = '<span class="spin" style="width:12px;height:12px;border-width:1.5px"></span> Fetching…';
  try {
    // Try UAE Central Bank
    let rate = null;
    try {
      const resp = await fetch(`https://www.centralbank.ae/umbraco/Surface/Exchange/GetExchangeRateAllCurrencies`, { mode: 'cors' });
      if (resp.ok) {
        const data = await resp.json();
        // CBUAE returns: [{currencyCode, rateValue}] where rateValue = AED per 100 units
        const entry = data.find(r => r.CurrencyCode === cur || r.currencyCode === cur);
        if (entry) {
          const rv = parseFloat(entry.Rate || entry.rateValue || entry.rate || 0);
          if (rv > 0) rate = rv / 100; // per 1 unit
        }
      }
    } catch (e) {}

    // Fallback: open.er-api.com (free, no key needed)
    if (!rate) {
      const resp = await fetch(`https://open.er-api.com/v6/latest/${CUR}`);
      const data = await resp.json();
      if (data && data.rates && data.rates[cur]) {
        // rates[cur] = how many {cur} per 1 {CUR}
        // We need: how many {CUR} per 1 {cur} = 1 / rates[cur]
        rate = 1 / data.rates[cur];
      }
    }

    if (rate && rate > 0) {
      rateInput.value = rate.toFixed(6);
      rateTxt.textContent = `1 ${cur} = ${rate.toFixed(4)} ${CUR}`;
    } else {
      rateTxt.textContent = `Could not fetch rate. Enter manually.`;
    }
  } catch (e) {
    rateTxt.textContent = `Rate fetch failed. Enter manually.`;
  }
}

