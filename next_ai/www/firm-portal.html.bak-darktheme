  document.getElementById(containerId).appendChild(row);
}

async function submitSalStructure() {
  const name = (document.getElementById('ss-name')||{}).value?.trim();
  const freq = (document.getElementById('ss-freq')||{}).value || 'Monthly';
  if (!name) { showMsg(document.getElementById('ss-msg'),'Please enter a structure name.','err'); return; }

  const collectRows = (prefix) => {
    const rows = document.querySelectorAll('[id^="ss-row-"]');
    const results = [];
    rows.forEach(row => {
      const idx = row.id.replace('ss-row-','');
      const compEl = document.getElementById(`${prefix}-${idx}`);
      if (!compEl) return;
      const comp = compEl.value;
      if (!comp) return;
      const amt = parseFloat((document.getElementById(`ss-amt-${idx}`)||{}).value||0);
      const formula = (document.getElementById(`ss-formula-${idx}`)||{}).value?.trim()||'';
      results.push({ salary_component: comp, amount: amt, formula });
    });
    return results;
  };

  /* Separate earnings vs deductions by which container the row is in */
  const earnings = [], deductions = [];
  document.querySelectorAll('[id^="ss-row-"]').forEach(row => {
    const idx = row.id.replace('ss-row-','');
    const comp = (document.getElementById(`ss-comp-${idx}`)||{}).value;
    if (!comp) return;
    const amt = parseFloat((document.getElementById(`ss-amt-${idx}`)||{}).value||0);
    const formula = (document.getElementById(`ss-formula-${idx}`)||{}).value?.trim()||'';
    const container = row.closest('#ss-earnings-rows') ? earnings : deductions;
    container.push({ salary_component: comp, amount: amt, formula });
  });

  const btn = document.getElementById('p-foot')?.querySelector('.btn-p');
  if (btn) { btn.disabled = true; btn.innerHTML = '<span class="spin"></span> Creating…'; }

  try {
    const res = await fc('next_ai.api.create_salary_structure', {
      name, payroll_frequency: freq,
      earnings: JSON.stringify(earnings),
      deductions: JSON.stringify(deductions)
    });
    closePanel();
    loadSalStructures();
  } catch(e) {
    if (btn) { btn.disabled = false; btn.innerHTML = '<i class="fas fa-save"></i> Create Structure'; }
    showMsg(document.getElementById('ss-msg'), e.message || 'Failed to create structure.', 'err');
  }
}

