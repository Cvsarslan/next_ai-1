async function loadLeads(status) {
  const el = document.getElementById('leads-list');
  const rows = await safeGet(() => fc('next_ai.api.get_leads', status === 'All' ? {} : { status }));
  _leads = rows || [];
  renderLeadsTable(_leads);
}

function filterLeads(status) {
  document.querySelectorAll('[id^="lead-f-"]').forEach(b => {
    b.style.background = ''; b.style.borderColor = ''; b.style.color = '';
  });
  const btn = document.getElementById('lead-f-' + status.replace(/ /g,'-'));
  if (btn) { btn.style.background='rgba(251,113,133,.15)'; btn.style.borderColor='#fb7185'; btn.style.color='#fb7185'; }
  loadLeads(status);
}

