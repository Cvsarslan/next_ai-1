  const totalDepr = withDepr.reduce((a,r)=>a+flt(r.accumulated_depreciation_amount||0),0);
  el.innerHTML = `
    <div style="background:rgba(167,139,250,.06);border:1px solid rgba(167,139,250,.2);border-radius:12px;padding:14px;margin-bottom:14px;display:flex;gap:16px;align-items:center">
