async function submitPayroll() {
  const start_date = (document.getElementById('pr-from')||{}).value;
  const end_date   = (document.getElementById('pr-to')||{}).value;
  const freq       = (document.getElementById('pr-freq')||{}).value || 'Monthly';
  const dept       = (document.getElementById('pr-dept')||{}).value?.trim() || null;

  if (!start_date || !end_date) { showMsg(document.getElementById('pr-msg'),'Please set the payroll period.','err'); return; }
  if (end_date < start_date) { showMsg(document.getElementById('pr-msg'),'End date must be after start date.','err'); return; }

  const btn = document.getElementById('pr-btn');
  if (btn) { btn.disabled = true; btn.innerHTML = '<span class="spin"></span> Processing…'; }
  document.getElementById('pr-result').innerHTML = '';

  try {
    const res = await fc('next_ai.api.run_payroll', {
      company: '', start_date, end_date, payroll_frequency: freq,
