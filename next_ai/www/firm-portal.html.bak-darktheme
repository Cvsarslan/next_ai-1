function renderDashFinance(el, d, kpi) {
  const months = d.monthly || [];
  const MONTH_SHORT = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];

  /* build SVG chart */
  const maxVal = Math.max(1, ...months.map(m => Math.max(flt(m.sales), flt(m.purchases))));
  const chartH = 130, chartW = 100; /* percentages for each column */
  const barW = 28, gap = 6, groupW = barW*2 + gap;
  const totalCols = months.length;
  const svgW = Math.max(400, totalCols * (groupW + 20));

  const svgBars = months.map((m, i) => {
    const sH = Math.max(3, Math.round(flt(m.sales) / maxVal * chartH));
    const pH = Math.max(3, Math.round(flt(m.purchases) / maxVal * chartH));
    const x = i * (groupW + 20) + 10;
    const mo = MONTH_SHORT[parseInt(m.period.split('-')[1]) - 1];
    return `
      <g>
        <rect x="${x}" y="${chartH - sH}" width="${barW}" height="${sH}" rx="4"
          fill="url(#gs)" opacity=".9">
          <title>${mo} Sales: ${CUR} ${fmtN(m.sales)}</title>
        </rect>
        <rect x="${x + barW + gap}" y="${chartH - pH}" width="${barW}" height="${pH}" rx="4"
          fill="url(#gp)" opacity=".85">
          <title>${mo} Purchase: ${CUR} ${fmtN(m.purchases)}</title>
        </rect>
        <text x="${x + barW + gap/2}" y="${chartH + 14}" text-anchor="middle"
