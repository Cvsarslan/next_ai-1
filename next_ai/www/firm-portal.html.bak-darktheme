async function loadAssets() {
  const el = document.getElementById('ast-list');
  const q = document.getElementById('ast-search')?.value||'';
  const rows = await safeGet(()=>fc('next_ai.api.get_assets',{search:q}));
  _assets = rows||[];
  if (!_assets.length) { el.innerHTML=`<div class="loading" style="color:var(--muted)">No assets found.</div>`; return; }
  const totalGross = _assets.reduce((a,r)=>a+flt(r.gross_purchase_amount||0),0);
  const totalNet   = _assets.reduce((a,r)=>a+flt(r.net_asset_value||0),0);
  const STATUS_C = {'Submit':'#60a5fa','In Location':'#4ade80','Scrapped':'#f87171','Sold':'#a78bfa','Partially Depreciated':'#f59e0b','Fully Depreciated':'#6b7280'};
  el.innerHTML = `
    <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px;margin-bottom:14px">
      ${[['Total Assets',_assets.length,'#34d399','fa-hashtag'],
         ['Gross Value',CUR+' '+fmtN(totalGross),'#60a5fa','fa-coins'],
         ['Net Book Value',CUR+' '+fmtN(totalNet),'#4ade80','fa-chart-line']
        ].map(([lbl,val,col,ico])=>`
      <div style="background:rgba(52,211,153,.06);border:1px solid rgba(52,211,153,.15);border-radius:12px;padding:12px;text-align:center">
        <i class="fas ${ico}" style="color:${col};margin-bottom:5px"></i>
        <div style="font-size:.65rem;color:var(--muted);margin-bottom:2px">${lbl}</div>
        <div style="font-size:.9rem;font-weight:800;color:${col}">${val}</div>
      </div>`).join('')}
    </div>
    <div class="tbl-wrap"><table class="tbl"><thead><tr>
      <th>Asset</th><th>Category</th><th>Purchase Date</th><th>Gross Value</th><th>Depreciation</th><th>Net Value</th><th>Status</th><th></th>
    </tr></thead><tbody>${_assets.map((r,i)=>{
      const c = STATUS_C[r.status]||'#9ca3af';
      const deprPct = r.gross_purchase_amount>0 ? Math.round((r.accumulated_depreciation_amount||0)/r.gross_purchase_amount*100) : 0;
      return `<tr style="cursor:pointer" onclick="viewAsset(_assets[${i}])"
        onmouseover="this.style.background='rgba(52,211,153,.05)'" onmouseout="this.style.background=''">
        <td><strong>${esc(r.asset_name)}</strong></td>
        <td style="font-size:.76rem;color:var(--muted)">${esc(r.asset_category||'—')}</td>
        <td style="font-size:.76rem;color:var(--muted)">${esc(r.purchase_date||'')}</td>
        <td style="font-weight:700">${CUR} ${fmtN(r.gross_purchase_amount||0)}</td>
        <td>
          <div style="height:4px;background:rgba(255,255,255,.08);border-radius:4px;margin-bottom:2px">
            <div style="height:100%;width:${deprPct}%;background:#f59e0b;border-radius:4px"></div>
          </div>
          <span style="font-size:.65rem;color:var(--muted)">${CUR} ${fmtN(r.accumulated_depreciation_amount||0)} (${deprPct}%)</span>
        </td>
        <td style="font-weight:800;color:#4ade80">${CUR} ${fmtN(r.net_asset_value||0)}</td>
        <td><span style="font-size:.68rem;padding:3px 9px;border-radius:20px;font-weight:700;background:${c}18;color:${c}">${esc(r.status||'')}</span></td>
        <td><button class="btn-s btn-sm" onclick="event.stopPropagation();viewAsset(_assets[${i}])"><i class="fas fa-eye"></i></button></td>
      </tr>`;
    }).join('')}</tbody></table></div>`;
}

