        <div style="font-size:.68rem;color:var(--muted);margin-bottom:2px">Total Received</div>
        <div style="font-size:1.1rem;font-weight:800;color:#4ade80">${CUR} ${fmtN(totalIn)}</div>
      </button>
      <button type="button" onclick="setPaymentFilter('Pay')" style="background:rgba(248,113,113,.08);border:1px solid ${_paymentFilter==='Pay'?'#f87171':'rgba(248,113,113,.2)'};border-radius:12px;padding:14px;text-align:center;cursor:pointer">
        <i class="fas fa-arrow-up" style="color:#f87171;margin-bottom:6px"></i>
        <div style="font-size:.68rem;color:var(--muted);margin-bottom:2px">Total Paid Out</div>
        <div style="font-size:1.1rem;font-weight:800;color:#f87171">${CUR} ${fmtN(totalOut)}</div>
      </button>
    </div>
    <div class="tbl-wrap"><table class="tbl"><thead><tr>
      <th>Ref #</th><th>Type</th><th>Party</th><th>Date</th><th>Mode</th><th>Amount</th>
    </tr></thead><tbody>${visibleRows.map(r=>{
      const isIn = r.payment_type==='Receive';
      return `<tr onmouseover="this.style.background='rgba(74,222,128,.04)'" onmouseout="this.style.background=''">
        <td style="font-size:.75rem;font-family:monospace;color:var(--muted)">${esc(r.reference_no||r.name)}</td>
        <td><span style="font-size:.68rem;padding:3px 8px;border-radius:20px;font-weight:700;
          background:${isIn?'rgba(74,222,128,.12)':'rgba(248,113,113,.12)'};
          color:${isIn?'#4ade80':'#f87171'}">${esc(r.payment_type)}</span></td>
        <td><strong>${esc(r.party_name||r.party)}</strong><div style="font-size:.65rem;color:var(--muted)">${esc(r.party_type)}</div></td>
        <td style="font-size:.78rem;color:var(--muted)">${esc(r.posting_date||'')}</td>
