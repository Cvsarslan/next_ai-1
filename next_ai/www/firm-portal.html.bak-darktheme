async function loadReconData() {
  const account = document.getElementById('recon-account')?.value;
  if (!account) { alert('Please select a bank account.'); return; }
  const m = document.getElementById('recon-month')?.value || todayStr().slice(0, 7);
  const [yr, mo] = m.split('-');
  const fd = `${yr}-${mo}-01`;
  const td = `${yr}-${mo}-${String(new Date(+yr, +mo, 0).getDate()).padStart(2, '0')}`;

  document.getElementById('recon-txns').innerHTML = '<div class="loading"><span class="spin"></span></div>';
  document.getElementById('recon-pays').innerHTML = '<div class="loading"><span class="spin"></span></div>';

  const data = await safeGet(() => fc('next_ai.api.get_unreconciled_transactions', { bank_account: account, from_date: fd, to_date: td }));
  _reconTxns     = (data?.transactions || []);
  _reconPayments = (data?.payments || []);
  _reconSelected = { txn: null, pay: null };

  document.getElementById('recon-txn-count').textContent = _reconTxns.length + ' pending';
  document.getElementById('recon-pay-count').textContent = _reconPayments.length + ' unmatched';

  renderReconTxns();
  renderReconPays();
}

function renderReconTxns() {
  const el = document.getElementById('recon-txns');
  if (!el) return;
  if (!_reconTxns.length) {
    el.innerHTML = `<div style="padding:14px;text-align:center;color:var(--muted);font-size:.76rem"><i class="fas fa-check-circle" style="color:#4ade80;display:block;font-size:1.5rem;margin-bottom:6px"></i>All transactions reconciled!</div>`;
    return;
  }
  el.innerHTML = _reconTxns.map((t, i) => {
    const isIn = flt(t.deposit || 0) > 0;
    const amt  = isIn ? t.deposit : t.withdrawal;
    const sel  = _reconSelected.txn?.name === t.name;
    return `<div id="rtxn-${i}" onclick="reconSelectTxn(${i})" style="background:${sel?'rgba(56,189,248,.15)':'rgba(255,255,255,.03)'};border:1px solid ${sel?'#38bdf8':'rgba(255,255,255,.07)'};border-radius:10px;padding:10px 12px;cursor:pointer;transition:.15s"
      onmouseover="if('${sel}'!='true')this.style.borderColor='rgba(56,189,248,.4)'" onmouseout="if('${sel}'!='true')this.style.borderColor='rgba(255,255,255,.07)'">
      <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:6px">
        <div style="flex:1;min-width:0">
          <div style="font-size:.75rem;font-weight:700;color:#fff;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">${esc(t.description || t.reference_number || '—')}</div>
          <div style="font-size:.63rem;color:var(--muted);margin-top:2px">${esc(t.date || '')} ${t.bank_party_name ? '· ' + esc(t.bank_party_name) : ''}</div>
        </div>
        <div style="text-align:right;flex-shrink:0">
          <div style="font-size:.82rem;font-weight:800;color:${isIn?'#4ade80':'#f87171'}">${isIn?'+':'-'}${CUR} ${fmtN(amt)}</div>
          <div style="font-size:.6rem;color:var(--muted)">${esc(t.status)}</div>
        </div>
      </div>
    </div>`;
  }).join('');
}

function renderReconPays(highlightAmount) {
  const el = document.getElementById('recon-pays');
  if (!el) return;
  if (!_reconPayments.length) {
    el.innerHTML = `<div style="padding:14px;text-align:center;color:var(--muted);font-size:.76rem"><i class="fas fa-info-circle" style="display:block;font-size:1.5rem;margin-bottom:6px"></i>No unmatched payment entries found.</div>`;
    return;
  }
  el.innerHTML = _reconPayments.map((p, i) => {
    const sel      = _reconSelected.pay?.name === p.name;
    const isSuggest = highlightAmount && Math.abs(flt(p.paid_amount) - highlightAmount) < 0.01;
    const isIn     = p.payment_type === 'Receive';
    return `<div id="rpay-${i}" onclick="reconSelectPay(${i})" style="background:${sel?'rgba(167,139,250,.2)':isSuggest?'rgba(74,222,128,.08)':'rgba(255,255,255,.03)'};border:1px solid ${sel?'#a78bfa':isSuggest?'rgba(74,222,128,.35)':'rgba(255,255,255,.07)'};border-radius:10px;padding:10px 12px;cursor:pointer;transition:.15s"
      onmouseover="if('${sel}'!='true')this.style.borderColor='rgba(167,139,250,.5)'" onmouseout="if('${sel}'!='true')this.style.borderColor='${isSuggest?'rgba(74,222,128,.35)':'rgba(255,255,255,.07)'}'">
      ${isSuggest ? `<div style="font-size:.6rem;color:#4ade80;font-weight:700;margin-bottom:4px"><i class="fas fa-magic" style="margin-right:3px"></i>Suggested Match</div>` : ''}
      <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:6px">
        <div style="flex:1;min-width:0">
          <div style="font-size:.74rem;font-weight:700;color:#fff;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">${esc(p.party_name || p.party || '—')}</div>
          <div style="font-size:.63rem;color:var(--muted);margin-top:2px">${esc(p.date || '')} · ${esc(p.payment_type)} · ${esc(p.mode_of_payment||'')}</div>
          <div style="font-size:.6rem;color:var(--muted);font-family:monospace">${esc(p.reference_no||p.name)}</div>
        </div>
        <div style="font-size:.82rem;font-weight:800;color:${isIn?'#4ade80':'#f87171'};flex-shrink:0">
          ${isIn?'+':'-'}${CUR} ${fmtN(p.paid_amount)}
        </div>
      </div>
    </div>`;
  }).join('');
}

function reconSelectTxn(idx) {
  _reconSelected.txn = _reconTxns[idx];
  renderReconTxns();
  const amt = flt(_reconSelected.txn?.deposit || _reconSelected.txn?.withdrawal || 0);
  renderReconPays(amt);
  reconUpdateMatchBar();
}

function reconSelectPay(idx) {
  _reconSelected.pay = _reconPayments[idx];
  renderReconPays(flt(_reconSelected.txn?.deposit || _reconSelected.txn?.withdrawal || 0));
  reconUpdateMatchBar();
}

function reconUpdateMatchBar() {
  const bar = document.getElementById('recon-match-bar');
  const desc = document.getElementById('recon-match-desc');
  if (!bar) return;
  const { txn, pay } = _reconSelected;
  if (txn && pay) {
    bar.style.display = 'block';
    const txnAmt = flt(txn.deposit || txn.withdrawal || 0);
    const diff = Math.abs(txnAmt - flt(pay.paid_amount || 0));
    desc.innerHTML = `<span style="color:#38bdf8">${esc(txn.description||txn.reference_number||txn.name)}</span>
      <span style="color:var(--muted)"> ↔ </span>
      <span style="color:#a78bfa">${esc(pay.party_name||pay.party||pay.name)}</span>
      ${diff > 0 ? `<span style="color:#f59e0b;font-size:.65rem;margin-left:6px">⚠ Amount diff: ${CUR} ${fmtN(diff)}</span>` : '<span style="color:#4ade80;font-size:.65rem;margin-left:6px">✓ Amounts match</span>'}`;
  } else if (txn || pay) {
    bar.style.display = 'block';
    desc.innerHTML = `<span style="color:var(--muted)">${txn ? 'Now select a payment entry on the right' : 'Now select a bank transaction on the left'}</span>`;
    document.getElementById('recon-confirm-btn').style.opacity = '0.4';
  } else {
    bar.style.display = 'none';
  }
  if (document.getElementById('recon-confirm-btn'))
    document.getElementById('recon-confirm-btn').style.opacity = (txn && pay) ? '1' : '0.4';
}

function reconClearSelection() {
  _reconSelected = { txn: null, pay: null };
  renderReconTxns();
  renderReconPays();
  reconUpdateMatchBar();
}

async function confirmReconcile() {
  const { txn, pay } = _reconSelected;
  if (!txn || !pay) return;
  const btn = document.getElementById('recon-confirm-btn');
  if (btn) { btn.disabled = true; btn.innerHTML = '<span class="spin"></span> Reconciling…'; }
  try {
    await fc('next_ai.api.reconcile_bank_transaction', {
      bank_transaction: txn.name, payment_entry: pay.name,
      amount: flt(txn.deposit || txn.withdrawal || pay.paid_amount || 0)
    });
    /* Remove reconciled items from local lists */
    _reconTxns     = _reconTxns.filter(t => t.name !== txn.name);
    _reconPayments = _reconPayments.filter(p => p.name !== pay.name);
    _reconSelected = { txn: null, pay: null };
    document.getElementById('recon-txn-count').textContent = _reconTxns.length + ' pending';
    document.getElementById('recon-pay-count').textContent = _reconPayments.length + ' unmatched';
    renderReconTxns();
    renderReconPays();
    reconUpdateMatchBar();
    showMsg(document.getElementById('recon-msg'), 'Reconciled successfully.', 'ok');
  } catch(e) {
    if (btn) { btn.disabled = false; btn.innerHTML = '<i class="fas fa-check" style="margin-right:5px"></i>Confirm Match'; }
    showMsg(document.getElementById('recon-msg'), e.message || 'Reconciliation failed.', 'err');
  }
}

