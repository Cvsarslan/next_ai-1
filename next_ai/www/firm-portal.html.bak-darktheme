/* ══════════════════════════════════════════
   UTILS
══════════════════════════════════════════ */
function esc(s) {
  if (s == null) return '';
  return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}
function fmtN(v) { return (parseFloat(v || 0)).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }
function fmt(v) { return CUR + ' ' + fmtN(v); }
function fmtC(v, cur) { return (cur || CUR) + ' ' + fmtN(v); }
function set(id, val) { const el = document.getElementById(id); if (el) el.textContent = val; }
function todayStr() {
  const d = new Date();
  return d.getFullYear() + '-' +
    String(d.getMonth() + 1).padStart(2, '0') + '-' +
    String(d.getDate()).padStart(2, '0');
}
function fillDL(id, arr, f) { const dl = document.getElementById(id); if (!dl) return; dl.innerHTML = arr.map(r => `<option value="${esc(r[f] || r.name)}">`).join(''); }
function showMsg(el, msg, type) { if (!el) return; el.innerHTML = `<div class="alert ${type === 'ok' ? 'a-ok' : 'a-err'}">${esc(msg)}</div>`; }

function toast(msg, type) {
  const el = document.getElementById('toast-el');
  el.textContent = msg; el.className = 'toast ' + (type || 'info') + ' show';
  setTimeout(() => el.classList.remove('show'), 3500);
}

/* ── Print ── */
function printDoc(dt, name) {
  const fmt = (document.getElementById('pf-sel') || {}).value || 'Standard';
  window.open(`/printview?doctype=${encodeURIComponent(dt)}&name=${encodeURIComponent(name)}&format=${encodeURIComponent(fmt)}&no_letterhead=0&_lang=en`, '_blank');
}
function dlPDF(dt, name) {
  const fmt = (document.getElementById('pf-sel') || {}).value || 'Standard';
  window.open(`/api/method/frappe.utils.print_format.download_pdf?doctype=${encodeURIComponent(dt)}&name=${encodeURIComponent(name)}&format=${encodeURIComponent(fmt)}&no_letterhead=0`, '_blank');
}

/* ── AI ── */
function toggleAI() { document.getElementById('ai-box').classList.toggle('open'); }
async function sendAI() {
  const inp = document.getElementById('ai-inp');
  const msg = inp.value.trim(); if (!msg) return;
  const msgs = document.getElementById('ai-msgs');
  msgs.innerHTML += `<div class="ai-msg ai-u">${esc(msg)}</div>`;
  inp.value = '';
  msgs.innerHTML += `<div class="ai-msg ai-b" id="ai-thinking"><span class="spin"></span></div>`;
  msgs.scrollTop = msgs.scrollHeight;
  try {
    const reply = await fc('next_ai.api.portal_ai_chat', { message: msg, company: COMPANY });
    document.getElementById('ai-thinking').outerHTML = `<div class="ai-msg ai-b">${esc(reply || '…')}</div>`;
  } catch (e) {
    document.getElementById('ai-thinking').outerHTML = `<div class="ai-msg ai-b" style="color:var(--danger)">Error: ${esc(e.message)}</div>`;
  }
  msgs.scrollTop = msgs.scrollHeight;
}

/* ── WhatsApp ── */
let _wa = null;
async function initWA() {
  try {
    _wa = await fc('next_ai.api.get_whatsapp_config', {});
    if (_wa && _wa.enabled && _wa.phone) document.getElementById('fab-wa').style.display = 'flex';
  } catch (e) {}
}
function openWA() {
  if (!_wa || !_wa.phone) return;
  window.open(`https://wa.me/${_wa.phone.replace(/\D/g, '')}?text=${encodeURIComponent(_wa.greeting || 'Hello!')}`, '_blank');
}

