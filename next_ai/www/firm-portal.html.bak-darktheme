            <i class="fas fa-check" style="color:#34d399;font-size:1.1rem"></i>
          </div>
          <div>
            <div style="font-size:.9rem;font-weight:800;color:#34d399">Payroll Entry Created</div>
            <div style="font-size:.72rem;color:var(--muted);margin-top:2px">${esc(res.name)}</div>
          </div>
        </div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px">
