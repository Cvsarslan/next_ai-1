    renderDashTab(_dashData);
  } catch(e) {
    const el = document.getElementById('dash-tab-content');
    if (el) el.innerHTML = `<div style="color:#f87171;padding:20px">Failed to load dashboard: ${esc(e.message||'')}</div>`;
