    await fc('next_ai.api.create_lead', {
      lead_name: name, company_name: document.getElementById('ld-company')?.value||'',
      email_id: document.getElementById('ld-email')?.value||'', mobile_no: document.getElementById('ld-mobile')?.value||'',
