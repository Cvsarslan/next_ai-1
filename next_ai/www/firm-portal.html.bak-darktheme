  try {
    await fc('next_ai.api.create_opportunity', {
      opportunity_from: document.getElementById('op-from')?.value||'Lead',
      party_name: party, opportunity_amount: document.getElementById('op-amt')?.value||0,
      probability: document.getElementById('op-prob')?.value||20,
      expected_closing: close, sales_stage: document.getElementById('op-stage')?.value||'Prospecting'
    });
    closePanel(); loadOpps();
