async function leaveAction(docName, action) {
  const approveBtn = document.getElementById('vlv-approve-btn');
  const rejectBtn  = document.getElementById('vlv-reject-btn');
  const msgEl      = document.getElementById('vlv-action-msg');
  if (approveBtn) approveBtn.disabled = true;
  if (rejectBtn)  rejectBtn.disabled  = true;
  try {
    await fc('next_ai.api.approve_leave', { name: docName, action });
    showMsg(msgEl, `Leave ${action === 'Approve' ? 'approved' : 'rejected'} successfully.`, 'ok');
    setTimeout(() => { closePanel(); loadLeaveData(); }, 1200);
  } catch(e) {
    showMsg(msgEl, e.message, 'err');
    if (approveBtn) approveBtn.disabled = false;
    if (rejectBtn)  rejectBtn.disabled  = false;
  }
}

