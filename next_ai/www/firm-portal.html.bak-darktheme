let _paymentRows = [], _paymentFilter = '';
function setPaymentFilter(filter) {
  _paymentFilter = _paymentFilter === filter ? '' : filter;
  loadPayments();
}

async function loadPayments() {
  const el = document.getElementById('pay-list');
  const m = document.getElementById('pay-month')?.value || todayStr().slice(0,7);
  const fd = m + '-01';
  const td = m + '-' + String(new Date(parseInt(m.split('-')[0]), parseInt(m.split('-')[1]), 0).getDate()).padStart(2,'0');
  const rows = await safeGet(()=>fc('next_ai.api.get_payment_entries',{from_date:fd, to_date:td}));
  if (!rows?.length) { el.innerHTML=`<div class="loading" style="color:var(--muted)">No payment entries for this period.</div>`; return; }
  const received = rows.filter(r=>r.payment_type==='Receive');
  const paid     = rows.filter(r=>r.payment_type==='Pay');
  const totalIn  = received.reduce((a,r)=>a+flt(r.paid_amount||0),0);
  const totalOut = paid.reduce((a,r)=>a+flt(r.paid_amount||0),0);
  _paymentRows = rows;
  const visibleRows = _paymentFilter ? rows.filter(r=>r.payment_type===_paymentFilter) : rows;
  el.innerHTML = `
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:14px">
      <button type="button" onclick="setPaymentFilter('Receive')" style="background:rgba(74,222,128,.08);border:1px solid ${_paymentFilter==='Receive'?'#4ade80':'rgba(74,222,128,.2)'};border-radius:12px;padding:14px;text-align:center;cursor:pointer">
