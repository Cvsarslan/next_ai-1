/* ── cache ── */
const _C = { customers: [], items: [], prefetched: false };

/* ── CSRF ── */
function csrf() {
  if (window.frappe && frappe.csrf_token && frappe.csrf_token !== 'None') return frappe.csrf_token;
  if (CSRF_TOKEN) return CSRF_TOKEN;
  const m = document.cookie.match(/X-Frappe-CSRF-Token=([^;]+)/);
  return m ? decodeURIComponent(m[1]) : '';
}

/* ── API ── */
async function fc(method, args) {
  const r = await fetch('/api/method/' + method, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json', 'X-Frappe-CSRF-Token': csrf(), 'X-Requested-With': 'XMLHttpRequest' },
    body: JSON.stringify(args)
  });
  const d = await r.json();
  if (!r.ok || d.exc || d.exc_type) throw new Error(parseErr(d) || 'Server error ' + r.status);
  return d.message;
}

async function fcGet(method, args) {
  const query = new URLSearchParams(args || {}).toString();
  const url = '/api/method/' + method + (query ? '?' + query : '');
  const r = await fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
  const d = await r.json();
  if (!r.ok || d.exc || d.exc_type) throw new Error(parseErr(d) || 'Server error ' + r.status);
  return d.message;
}

async function getList(doctype, fields, filters, limit) {
  const f = (fields || ['name']).map(x => '"' + x + '"').join(',');
  let url = `/api/resource/${encodeURIComponent(doctype)}?fields=[${f}]&limit_page_length=${limit || 100}&order_by=creation desc`;
  if (filters) url += '&filters=' + encodeURIComponent(JSON.stringify(filters));
  const r = await fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
  const d = await r.json();
  if (!r.ok) throw new Error('Failed to load ' + doctype);
  return d.data || [];
}

function parseErr(d) {
  if (!d) return '';
  if (d._server_messages) {
    try { const m = JSON.parse(d._server_messages); return JSON.parse(m[0]).message || ''; } catch (e) {}
  }
  if (d.exception) return d.exception.split('\n').pop();
  return '';
}

async function safeGet(fn) { try { return await fn(); } catch (e) { return []; } }

let _portalInsights = null;
let _transactionSeries = null;
async function loadPortalInsights(force=false) {
  if (!_portalInsights || force) {
    _portalInsights = await fcGet('next_ai.api.get_portal_insights', {});
  }
  return _portalInsights;
}

async function loadNamingSeriesSelect(selectId, doctype) {
  const select = document.getElementById(selectId);
  if (!select) return;
  try {
    if (!_transactionSeries) _transactionSeries = await fcGet('next_ai.api.get_transaction_naming_series', {});
    const config = _transactionSeries[doctype] || {options:[],default:''};
    select.innerHTML = config.options.map(series=>`<option value="${esc(series)}" ${series===config.default?'selected':''}>${esc(series)}</option>`).join('');
    if (!config.options.length) select.innerHTML = '<option value="">Use system default</option>';
  } catch(e) {
    select.innerHTML = '<option value="">Use system default</option>';
  }
}

function metricCards(cards) {
  return `<div class="module-metrics">${cards.map(c=>`
    <div class="metric-card" ${c.onclick ? `role="button" tabindex="0" onclick="${c.onclick}" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();${c.onclick}}"` : ''}
      style="--metric-color:${c.color};${c.onclick?'cursor:pointer;':''}${c.active?`border-color:${c.color};box-shadow:0 0 0 2px ${c.color}22;transform:translateY(-2px);`:''}">
      <div class="metric-icon"><i class="fas ${c.icon}"></i></div>
      <div class="metric-value">${c.value}</div>
      <div class="metric-label">${c.label}</div>
      <div class="metric-note">${c.note||''}${c.onclick?' · Click to filter':''}</div>
    </div>`).join('')}</div>`;
}

function salesTrendVisual(monthly, color='#34d399') {
  const rows = monthly || [];
  if (!rows.length) return '<div class="loading" style="padding:24px">No sales trend yet.</div>';
  const max = Math.max(1, ...rows.map(r=>flt(r.total)));
  return `<div class="trend-bars">${rows.map(r=>{
    const height = Math.max(5, Math.round(flt(r.total)/max*88));
    return `<div class="trend-col" title="${esc(r.period)}: ${CUR} ${fmtN(r.total)}">
      <div style="font-size:.54rem;color:${color};font-weight:700">${fmtN(r.total)}</div>
      <div class="trend-bar" style="height:${height}px;background:linear-gradient(180deg,${color},color-mix(in srgb,${color} 62%,#000))"></div>
      <div class="trend-label">${esc((r.period||'').slice(5))}</div>
    </div>`;
  }).join('')}</div>`;
}

function rankedCustomersVisual(rows) {
  const data = rows || [];
  if (!data.length) return '<div class="loading" style="padding:24px">No billed customers yet.</div>';
  const max = Math.max(1, ...data.map(r=>flt(r.total)));
  return data.map((r,i)=>`<div style="margin-bottom:9px">
    <div style="display:flex;justify-content:space-between;gap:8px;margin-bottom:4px">
      <span style="font-size:.67rem;color:var(--text);white-space:nowrap;overflow:hidden;text-overflow:ellipsis">${i+1}. ${esc(r.customer_name||'Customer')}</span>
      <span style="font-size:.65rem;font-weight:800;color:#22d3ee">${CUR} ${fmtN(r.total)}</span>
    </div>
    <div style="height:5px;background:rgba(255,255,255,.06);border-radius:4px"><div style="height:100%;width:${Math.round(flt(r.total)/max*100)}%;background:linear-gradient(90deg,#0891b2,#22d3ee);border-radius:4px"></div></div>
  </div>`).join('');
}

/* ── Prefetch ── */
async function prefetch() {
  if (_C.prefetched) return;
  const [custs, items] = await Promise.all([
    safeGet(() => getList('Customer', ['name', 'customer_name'], null, 300)),
    safeGet(() => getList('Item', ['name', 'item_name', 'stock_uom'], null, 500)),
  ]);
  _C.customers = custs;
  _C.items = items;
  _C.prefetched = true;
}

function sidebarGroupKey(label) {
  return (label.dataset.groupKey || label.textContent).trim().toLowerCase().replace(/[^a-z0-9]+/g, '-');
}

function setSidebarGroup(label, expanded, persist=true) {
  label.classList.toggle('collapsed', !expanded);
  let node = label.nextElementSibling;
  while (node && !node.classList.contains('sb-lbl')) {
    if (node.classList.contains('sb-item')) node.classList.toggle('sb-group-hidden', !expanded);
    node = node.nextElementSibling;
  }
  if (persist) {
    const state = JSON.parse(localStorage.getItem('apex-sidebar-groups') || '{}');
    state[sidebarGroupKey(label)] = expanded;
    localStorage.setItem('apex-sidebar-groups', JSON.stringify(state));
  }
}

function initSidebarGroups() {
  const state = JSON.parse(localStorage.getItem('apex-sidebar-groups') || '{}');
  document.querySelectorAll('.sidebar .sb-lbl').forEach(label => {
    const text = label.textContent.trim();
    label.dataset.groupKey = text.toLowerCase().replace(/[^a-z0-9]+/g, '-');
    label.insertAdjacentHTML('beforeend', '<i class="fas fa-chevron-down sb-chevron"></i>');
    label.setAttribute('role', 'button');
    label.setAttribute('tabindex', '0');
    const defaultOpen = ['Overview','Sales & Customers'].includes(text);
    const expanded = state[label.dataset.groupKey] ?? defaultOpen;
    setSidebarGroup(label, expanded, false);
    const toggle = () => setSidebarGroup(label, label.classList.contains('collapsed'));
    label.addEventListener('click', toggle);
    label.addEventListener('keydown', e => { if (e.key==='Enter' || e.key===' ') { e.preventDefault(); toggle(); } });
  });
}

function revealSidebarItem(item) {
  if (!item) return;
  let label = item.previousElementSibling;
  while (label && !label.classList.contains('sb-lbl')) label = label.previousElementSibling;
  if (label) setSidebarGroup(label, true);
}

