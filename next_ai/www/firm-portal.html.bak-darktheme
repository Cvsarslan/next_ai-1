        ${cols.map(([hdr])=>`<th>${esc(hdr)}</th>`).join('')}
      </tr></thead><tbody>
        ${(res.rows||[]).map(row=>`<tr>
          ${cols.map(([,key])=>{
            const val = row[key];
            if (key==='party_name' && row.party) {
              return `<td><button onclick='openCustomerConnections(${JSON.stringify(String(row.party))})' style="background:none;border:none;padding:0;color:#22d3ee;font:inherit;font-weight:750;cursor:pointer;text-align:left">${esc(String(val||row.party))}<i class="fas fa-arrow-up-right-from-square" style="font-size:.52rem;margin-left:5px;opacity:.65"></i></button></td>`;
            }
            const isMoney = /(amount|pay|total|billed|outstanding|gross|net|tax|depreciation)/.test(key) && !/(count|invoices)/.test(key);
            const isCount = /(count|invoices)$/.test(key);
            const display = isMoney && val!==undefined ? CUR+' '+fmtN(val) : isCount ? fmtN(val||0) : esc(String(val??'—'));
            return `<td ${(isMoney||isCount)?`style="font-weight:700;color:${col}"`:''}>${display}</td>`;
          }).join('')}
        </tr>`).join('')}
      </tbody></table></div>`;
