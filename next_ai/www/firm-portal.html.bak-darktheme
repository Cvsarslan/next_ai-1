/* ── Submit: Journal Entry ── */
async function submitQCJE() {
  const btn=document.getElementById('qje-btn'), msg=document.getElementById('qje-msg');
  const rows=[...document.querySelectorAll('#qje-rows .qje-row')];
  const accounts=rows.map(r=>({
    account: r.querySelector('.qje-acc').value.trim(),
    debit_in_account_currency: parseFloat(r.querySelector('.qje-dr').value)||0,
    credit_in_account_currency: parseFloat(r.querySelector('.qje-cr').value)||0,
  })).filter(a=>a.account);
  if(accounts.length<2){showMsg(msg,'Add at least 2 account rows','err');return;}
  btn.disabled=true; btn.innerHTML='<span class="spin"></span> Saving…';
  try {
    const res = await fc('next_ai.api.create_journal_entry', {
      voucher_type: document.getElementById('qje-type').value,
      posting_date: document.getElementById('qje-date').value,
      company: document.getElementById('qje-co').value,
      user_remark: document.getElementById('qje-rmk').value,
      accounts: JSON.stringify(accounts),
    });
    showMsg(msg, `Journal Entry "${res.name}" saved!`, 'ok');
    setTimeout(closePanel, 1400);
  } catch(e) { showMsg(msg, e.message, 'err'); btn.disabled=false; btn.innerHTML='<i class="fas fa-save"></i> Save Draft'; }
}

