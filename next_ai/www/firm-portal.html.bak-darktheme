function switchDashTab(tab) {
  _dashTab = tab;
  const tabs = [
    { id:'finance', col:'#6366f1' }, { id:'crm', col:'#fb7185' },
    { id:'hr', col:'#a78bfa' }, { id:'banking', col:'#22d3ee' }, { id:'buying', col:'#f97316' },
  ];
  const icons = { finance:'fa-chart-line', crm:'fa-bullseye', hr:'fa-id-badge', banking:'fa-university', buying:'fa-cart-arrow-down' };
  const labels = { finance:'Finance', crm:'CRM', hr:'HR', banking:'Banking', buying:'Buying' };
  tabs.forEach(t => {
    const btn = document.getElementById('dtab-' + t.id);
    if (!btn) return;
    if (t.id === tab) {
      btn.style.background = t.col + '22'; btn.style.color = t.col; btn.style.borderColor = t.col + '40';
    } else {
      btn.style.background = 'transparent'; btn.style.color = 'var(--muted)'; btn.style.borderColor = 'transparent';
    }
  });
  if (_dashData) renderDashTab(_dashData);
}

function renderDashTab(d) {
  const el = document.getElementById('dash-tab-content');
  if (!el) return;
  const kpi = d.kpi || {};
  if (_dashTab === 'finance') renderDashFinance(el, d, kpi);
  else if (_dashTab === 'crm')  renderDashCRM(el, d, kpi);
  else if (_dashTab === 'hr')   renderDashHR(el, d, kpi);
  else if (_dashTab === 'banking') renderDashBanking(el, d, kpi);
  else if (_dashTab === 'buying')  renderDashBuying(el, d, kpi);
}

async function loadDashboardData() {
  try {
    if (!_dashData) {
      _dashData = await fcGet('next_ai.api.get_dashboard_overview', {});
