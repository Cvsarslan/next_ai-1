                <div style="width:40px;height:40px;border-radius:12px;background:linear-gradient(135deg,${col}33,${col}18);border:1px solid ${col}44;display:flex;align-items:center;justify-content:center;font-size:.82rem;font-weight:800;color:${col};flex-shrink:0">
                  ${initials}
                </div>
                <div style="flex:1;min-width:0">
                  <div style="font-size:.86rem;font-weight:700;color:#fff;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">${esc(e.employee_name||e.name)}</div>
                  <div style="display:flex;align-items:center;gap:6px;margin-top:2px">
                    <span style="font-size:.65rem;color:var(--muted)">${esc(e.name)}</span>
                    ${e.department ? `<span style="width:3px;height:3px;border-radius:50%;background:var(--muted);display:inline-block"></span><span style="font-size:.65rem;color:${col};font-weight:600">${esc(e.department)}</span>` : ''}
                    ${e.designation ? `<span style="width:3px;height:3px;border-radius:50%;background:var(--muted);display:inline-block"></span><span style="font-size:.62rem;color:var(--muted)">${esc(e.designation)}</span>` : ''}
                  </div>
                </div>
                <i class="fas fa-chevron-right" style="color:var(--muted);font-size:.65rem;opacity:.4;flex-shrink:0"></i>
              </div>`;
            }).join('')}
          </div>
        </div>`;
      /* Replace the initial spinner with the "select employee" prompt */
      ciLoadLog();
    } else {
      document.getElementById('ci-name').textContent = 'No employees found';
      document.getElementById('ci-dept').textContent = 'Create employee records first in ERPNext HR module';
      document.getElementById('ci-av').textContent = '!';
      document.getElementById('ci-av').style.background = 'linear-gradient(135deg,#dc2626,#991b1b)';
    }
  }).catch(err => {
    document.getElementById('ci-name').textContent = 'Error: ' + (err.message || 'Could not load employee data');
  });
}

let _ciAllEmps = [];

function ciSetEmployee(emp) {
  _ci.emp = emp;
  const wrap = document.getElementById('ci-emp-wrap');
  const avatarColor = `linear-gradient(135deg,#f59e0b,#d97706)`;
  wrap.innerHTML = `
    <div style="background:var(--card);border:1px solid var(--border2);border-radius:16px;padding:20px;display:flex;align-items:center;gap:16px;max-width:520px">
      <div style="width:56px;height:56px;border-radius:50%;background:${avatarColor};display:flex;align-items:center;justify-content:center;font-size:1.4rem;color:#fff;flex-shrink:0;font-weight:800">
        ${(emp.employee_name||emp.name||'E')[0].toUpperCase()}
      </div>
      <div style="flex:1;min-width:0">
        <div style="font-size:1.05rem;font-weight:800;color:#fff">${esc(emp.employee_name||emp.name)}</div>
        <div style="font-size:.75rem;color:var(--text2);margin-top:3px">${esc([emp.designation,emp.department].filter(Boolean).join(' · '))}</div>
        <div style="font-size:.7rem;color:var(--muted);margin-top:2px">${esc(emp.name)}</div>
      </div>
      <button class="btn-s" onclick="ciClearEmployee()" title="Change employee" style="flex-shrink:0">
        <i class="fas fa-exchange-alt"></i> Change
      </button>
    </div>`;
  ciLoadTodayLog();
}

function ciClearEmployee() {
  _ci.emp = null;
  renderCheckin();
}

function ciSelectEmployee(empName) {
  if (!empName) { _ci.emp = null; return; }
  const emp = _ciAllEmps.find(e => e.name === empName);
  if (!emp) return;
  /* Jump straight to the linked-employee view */
  ciSetEmployee(emp);
}

function ciFilterEmps(q) {
  const cards = document.querySelectorAll('.ci-emp-card');
  const lq = q.toLowerCase();
  let visible = 0;
  cards.forEach(card => {
    const match = !lq ||
      card.dataset.name.toLowerCase().includes(lq) ||
      card.dataset.id.toLowerCase().includes(lq) ||
      card.dataset.dept.toLowerCase().includes(lq);
    card.style.display = match ? 'flex' : 'none';
    if (match) visible++;
  });
  /* show "no match" message */
  let noMsg = document.getElementById('ci-no-match');
  if (!noMsg) {
    noMsg = document.createElement('div');
    noMsg.id = 'ci-no-match';
    noMsg.style.cssText = 'padding:20px;text-align:center;font-size:.8rem;color:var(--muted);display:none';
    noMsg.innerHTML = '<i class="fas fa-search" style="display:block;font-size:1.2rem;opacity:.3;margin-bottom:8px"></i>No employees match your search';
    document.getElementById('ci-emp-list').appendChild(noMsg);
  }
  noMsg.style.display = visible === 0 ? 'block' : 'none';
}

function ciToggleGeo() {
  const btn    = document.getElementById('ci-loc-btn');
  const status = document.getElementById('ci-loc-status');
  const detail = document.getElementById('ci-loc-detail');

  if (_ci.watching) {
    if (_ci.watchId !== null) navigator.geolocation.clearWatch(_ci.watchId);
    _ci.watching = false; _ci.lat = null; _ci.lon = null; _ci.accuracy = null;
    btn.innerHTML = '<i class="fas fa-location-crosshairs"></i> Enable GPS';
    btn.style.background = ''; btn.style.color = '';
    status.textContent = 'Not tracking';
    status.style.color = 'var(--muted)';
    detail.style.display = 'none';
    ciUpdateCheckinButtons();
    return;
  }
  if (!navigator.geolocation) {
    showMsg(document.getElementById('ci-result'), 'Geolocation is not supported by this browser.', 'err'); return;
  }

  /* Acquiring state */
  _ci.watching = true;
  btn.innerHTML = '<span class="spin" style="width:12px;height:12px;border-width:2px;border-color:#fff rgba(255,255,255,.2) rgba(255,255,255,.2) rgba(255,255,255,.2)"></span> Acquiring…';
  btn.style.background = 'rgba(34,211,238,.15)';
  btn.style.color = '#22d3ee';
  btn.style.border = '1px solid rgba(34,211,238,.3)';
  status.textContent = 'Requesting GPS access…';
  status.style.color = '#f59e0b';
  detail.style.display = 'block';
  document.getElementById('ci-lat').textContent = '—';
  document.getElementById('ci-lon').textContent = '—';
  document.getElementById('ci-acc-txt').textContent = 'Accuracy: calculating…';
  document.getElementById('ci-map-link').style.display = 'none';

  const onSuccess = pos => {
    _ci.lat      = pos.coords.latitude;
    _ci.lon      = pos.coords.longitude;
    _ci.accuracy = pos.coords.accuracy;

    document.getElementById('ci-lat').textContent = _ci.lat.toFixed(6);
    document.getElementById('ci-lon').textContent = _ci.lon.toFixed(6);
    document.getElementById('ci-acc-txt').textContent = `±${Math.round(_ci.accuracy)} m accuracy`;
    document.getElementById('ci-map-a').href = `https://www.google.com/maps?q=${_ci.lat},${_ci.lon}`;
    document.getElementById('ci-map-link').style.display = 'block';

    /* Locked state */
    status.textContent = `GPS Locked · ±${Math.round(_ci.accuracy)}m`;
    status.style.color = '#10b981';
    btn.innerHTML = '<i class="fas fa-satellite-dish" style="color:#10b981"></i> GPS Active · Disable';
    btn.style.background = 'rgba(16,185,129,.12)';
    btn.style.color = '#10b981';
    btn.style.border = '1px solid rgba(16,185,129,.3)';
    ciUpdateCheckinButtons();
  };

  const onError = err => {
    _ci.watching = false; _ci.lat = null; _ci.lon = null;
    status.textContent = 'GPS denied: ' + err.message;
    status.style.color = '#f87171';
    btn.innerHTML = '<i class="fas fa-location-crosshairs"></i> Enable GPS';
    btn.style.background = ''; btn.style.color = ''; btn.style.border = '';
    detail.style.display = 'none';
    ciUpdateCheckinButtons();
    showMsg(document.getElementById('ci-result'), 'GPS access denied. Allow location permission in your browser.', 'err');
  };

  _ci.watchId = navigator.geolocation.watchPosition(onSuccess, onError,
    { enableHighAccuracy: true, maximumAge: 5000, timeout: 20000 });
}

function ciUpdateCheckinButtons() {
  const inBtn  = document.getElementById('ci-in-btn');
  const outBtn = document.getElementById('ci-out-btn');
  if (!inBtn || !outBtn) return;
  const hasGps = _ci.lat !== null;
  const gpsHint = document.getElementById('ci-gps-hint');
  if (gpsHint) {
    gpsHint.style.display = hasGps ? 'none' : 'flex';
    gpsHint.innerHTML = hasGps ? '' : '<i class="fas fa-info-circle" style="color:#f59e0b;margin-right:6px"></i><span style="color:#f59e0b;font-size:.72rem">Enable GPS above to record your location with this check-in</span>';
  }
}

function ciNowStr() {
  const d = new Date();
  /* Use local time (not UTC) so it matches the server timezone */
  return d.getFullYear() + '-' +
    String(d.getMonth()+1).padStart(2,'0') + '-' +
    String(d.getDate()).padStart(2,'0') + ' ' +
    String(d.getHours()).padStart(2,'0') + ':' +
    String(d.getMinutes()).padStart(2,'0') + ':' +
    String(d.getSeconds()).padStart(2,'0');
}

function ciFormatDuration(ms) {
  const totalSec = Math.floor(ms / 1000);
  const h = Math.floor(totalSec / 3600);
  const m = Math.floor((totalSec % 3600) / 60);
  const s = totalSec % 60;
  return `${String(h).padStart(2,'0')}:${String(m).padStart(2,'0')}:${String(s).padStart(2,'0')}`;
}

function ciStartShiftTimer(checkInTime) {
  _ci.lastCheckInTime = checkInTime;
  const timerEl  = document.getElementById('ci-shift-timer');
  const startEl  = document.getElementById('ci-shift-start');
  const elapsed  = document.getElementById('ci-shift-elapsed');
  if (!timerEl || !startEl || !elapsed) return;

  timerEl.style.display = 'block';
  startEl.textContent = checkInTime.substr(11, 8);

  if (_ci.shiftTimerInterval) clearInterval(_ci.shiftTimerInterval);
  const checkInMs = new Date(checkInTime.replace(' ', 'T')).getTime();
  _ci.shiftTimerInterval = setInterval(() => {
    const elEl = document.getElementById('ci-shift-elapsed');
    if (elEl) elEl.textContent = ciFormatDuration(Date.now() - checkInMs);
  }, 1000);
}

function ciStopShiftTimer() {
  if (_ci.shiftTimerInterval) { clearInterval(_ci.shiftTimerInterval); _ci.shiftTimerInterval = null; }
  const timerEl = document.getElementById('ci-shift-timer');
  if (timerEl) timerEl.style.display = 'none';
  _ci.lastCheckInTime = null;
}

async function doCheckin(logType) {
  if (!_ci.emp || !_ci.emp.name) {
    showMsg(document.getElementById('ci-result'), 'Please select an employee first.', 'err'); return;
  }
  const btn = document.getElementById(logType === 'IN' ? 'ci-in-btn' : 'ci-out-btn');
  const res = document.getElementById('ci-result');
  const origHTML = btn.innerHTML;
  btn.disabled = true;
  btn.innerHTML = '<span class="spin" style="width:16px;height:16px;border-width:2px"></span> Recording…';

  try {
    const timeStr = ciNowStr();

    const r = await fc('next_ai.api.employee_checkin', {
      employee:  _ci.emp.name,
      log_type:  logType,
      time:      timeStr,
      latitude:  _ci.lat  !== null ? String(_ci.lat)  : '0',
      longitude: _ci.lon  !== null ? String(_ci.lon)  : '0',
    });

    if (logType === 'IN') {
      /* ── CHECK IN ── */
      ciStartShiftTimer(timeStr);
      const gpsLine = _ci.lat ? `📍 ${_ci.lat.toFixed(5)}, ${_ci.lon.toFixed(5)} · ±${Math.round(_ci.accuracy||0)}m` : 'No GPS recorded';
      res.innerHTML = `
        <div style="background:linear-gradient(135deg,rgba(16,185,129,.12),rgba(5,150,105,.06));border:1px solid rgba(16,185,129,.3);border-radius:14px;padding:18px;display:flex;align-items:center;gap:14px">
          <div style="width:44px;height:44px;border-radius:12px;background:linear-gradient(135deg,#059669,#047857);display:flex;align-items:center;justify-content:center;flex-shrink:0">
            <i class="fas fa-sign-in-alt" style="color:#fff;font-size:1.2rem"></i>
          </div>
          <div style="flex:1">
            <div style="font-size:.94rem;font-weight:800;color:#fff;margin-bottom:3px">Checked In Successfully</div>
            <div style="font-size:.74rem;color:#34d399;margin-bottom:3px">${esc(_ci.emp.employee_name||_ci.emp.name)} · ${timeStr.substr(11,8)}</div>
            <div style="font-size:.68rem;color:var(--muted)">${gpsLine}</div>
          </div>
          <div style="text-align:center;background:rgba(16,185,129,.1);border:1px solid rgba(16,185,129,.2);border-radius:10px;padding:8px 12px">
            <div style="font-size:1.1rem;font-weight:900;color:#10b981">${timeStr.substr(11,8)}</div>
            <div style="font-size:.58rem;color:var(--muted)">START TIME</div>
          </div>
        </div>`;

    } else {
      /* ── CHECK OUT ── */
      const checkOutTime = timeStr;
      let durationStr = '—';
      let durationMs  = 0;
      let startTime   = _ci.lastCheckInTime;

      /* If no in-memory check-in time, fetch last IN from today's log */
      if (!startTime) {
        try {
          const logs = await fc('next_ai.api.get_checkin_log', { employee: _ci.emp.name, from_date: todayStr(), to_date: todayStr() });
          const lastIn = logs.slice().sort((a,b)=>a.time.localeCompare(b.time)).filter(x=>x.log_type==='IN').pop();
          if (lastIn) startTime = lastIn.time;
        } catch {}
      }

      if (startTime) {
        durationMs  = new Date(checkOutTime.replace(' ','T')) - new Date(startTime.replace(' ','T'));
        durationStr = ciFormatDuration(Math.max(0, durationMs));
      }

      const totalMins = Math.round(durationMs / 60000);
      const hrs  = Math.floor(totalMins / 60);
      const mins = totalMins % 60;
      const durationPretty = hrs > 0 ? `${hrs}h ${mins}m` : `${mins}m`;

      ciStopShiftTimer();
      const gpsLine = _ci.lat ? `📍 ${_ci.lat.toFixed(5)}, ${_ci.lon.toFixed(5)}` : 'No GPS';
      res.innerHTML = `
        <div style="background:linear-gradient(135deg,rgba(99,102,241,.1),rgba(124,58,237,.06));border:1px solid rgba(99,102,241,.3);border-radius:16px;overflow:hidden">
          <!-- Header -->
          <div style="padding:16px 18px;border-bottom:1px solid rgba(255,255,255,.06);display:flex;align-items:center;gap:12px">
            <div style="width:40px;height:40px;border-radius:12px;background:linear-gradient(135deg,#7c3aed,#6366f1);display:flex;align-items:center;justify-content:center;flex-shrink:0">
              <i class="fas fa-flag-checkered" style="color:#fff;font-size:1rem"></i>
            </div>
            <div>
              <div style="font-size:.94rem;font-weight:800;color:#fff">Shift Completed</div>
              <div style="font-size:.72rem;color:#a78bfa">${esc(_ci.emp.employee_name||_ci.emp.name)} · ${todayStr()}</div>
            </div>
          </div>
          <!-- Time summary -->
          <div style="display:grid;grid-template-columns:1fr 1fr 1fr;padding:16px 18px;gap:12px">
            <div style="text-align:center">
              <div style="font-size:.58rem;font-weight:700;text-transform:uppercase;letter-spacing:.6px;color:var(--muted);margin-bottom:5px">Check In</div>
              <div style="font-size:1.1rem;font-weight:900;color:#10b981">${startTime ? startTime.substr(11,8) : '—'}</div>
            </div>
            <div style="text-align:center;border-left:1px solid rgba(255,255,255,.06);border-right:1px solid rgba(255,255,255,.06)">
              <div style="font-size:.58rem;font-weight:700;text-transform:uppercase;letter-spacing:.6px;color:var(--muted);margin-bottom:5px">Check Out</div>
              <div style="font-size:1.1rem;font-weight:900;color:#f87171">${checkOutTime.substr(11,8)}</div>
            </div>
            <div style="text-align:center">
              <div style="font-size:.58rem;font-weight:700;text-transform:uppercase;letter-spacing:.6px;color:var(--muted);margin-bottom:5px">Total Shift</div>
              <div style="font-size:1.1rem;font-weight:900;color:#c084fc">${durationPretty || durationStr}</div>
            </div>
          </div>
          <!-- Stopwatch display -->
          <div style="margin:0 18px 16px;background:rgba(99,102,241,.08);border:1px solid rgba(99,102,241,.2);border-radius:10px;padding:12px;text-align:center">
            <div style="font-size:2rem;font-weight:900;color:#fff;letter-spacing:2px;font-variant-numeric:tabular-nums">${durationStr}</div>
            <div style="font-size:.62rem;color:var(--muted);margin-top:3px">total shift duration · ${gpsLine}</div>
          </div>
        </div>`;
    }

    setTimeout(() => {
      ciLoadTodayLog();
      const f = document.getElementById('ci-log-from');
      const t = document.getElementById('ci-log-to');
      if (f) f.value = todayStr();
      if (t) t.value = todayStr();
    }, 600);

  } catch(e) {
    showMsg(res, e.message, 'err');
  } finally {
    btn.disabled = false;
    btn.innerHTML = origHTML;
  }
}

function ciLoadTodayLog() {
  /* set default dates to today then load */
  const today = todayStr();
  const f = document.getElementById('ci-log-from');
  const t = document.getElementById('ci-log-to');
  if (f && !f.value) f.value = today;
  if (t && !t.value) t.value = today;
  ciLoadLog();
}

async function ciLoadLog() {
  const wrap = document.getElementById('ci-log-wrap');
  const subtitle = document.getElementById('ci-log-subtitle');
  if (!wrap) return;
  if (!_ci.emp || !_ci.emp.name) {
    if (subtitle) subtitle.textContent = 'Select an employee above';
    wrap.innerHTML = '<div style="padding:40px;text-align:center;color:var(--muted)"><i class="fas fa-user-slash" style="font-size:2rem;display:block;margin-bottom:12px;opacity:.25"></i><div style="font-size:.84rem">Select an employee above to view their check-in logs</div></div>';
    return;
  }

  const today = todayStr();
  const fromEl = document.getElementById('ci-log-from');
  const toEl   = document.getElementById('ci-log-to');
  if (fromEl && !fromEl.value) fromEl.value = today;
  if (toEl   && !toEl.value)   toEl.value   = today;

  const from = (fromEl ? fromEl.value : null) || today;
  const to   = (toEl   ? toEl.value   : null) || today;

  wrap.innerHTML = '<div class="loading" style="padding:30px"><span class="spin"></span></div>';
  if (subtitle) subtitle.textContent = `${_ci.emp.employee_name || _ci.emp.name} · ${from} → ${to}`;

  const setS = (id, v) => { const el = document.getElementById(id); if (el) el.textContent = v; };

  try {
    const rows = await fc('next_ai.api.get_checkin_log', {
      employee: _ci.emp.name, from_date: from, to_date: to
    });

    const total = rows.length;
    const cntIn  = rows.filter(r => r.log_type === 'IN').length;
    const cntOut = rows.filter(r => r.log_type === 'OUT').length;
    const cntGps = rows.filter(r => r.latitude && r.latitude !== 0).length;
    setS('ci-stat-total', total);
    setS('ci-stat-in',    cntIn);
    setS('ci-stat-out',   cntOut);
    setS('ci-stat-gps',   cntGps);

    if (!rows.length) {
      wrap.innerHTML = `<div style="padding:48px;text-align:center">
        <i class="fas fa-calendar-xmark" style="font-size:2rem;color:var(--muted);opacity:.3;display:block;margin-bottom:12px"></i>
        <div style="font-size:.86rem;color:var(--muted)">No check-in records for this date range</div>
        <div style="font-size:.72rem;color:var(--muted);margin-top:4px;opacity:.6">${from} to ${to}</div>
      </div>`;
      return;
    }

    /* Group by calendar date (rows are DESC by time from API) */
    const byDate = {};
    rows.forEach(r => {
      const d = r.time ? r.time.substr(0, 10) : 'Unknown';
      if (!byDate[d]) byDate[d] = [];
      byDate[d].push(r);
    });

    const fmtDur = mins => {
      if (!mins || mins <= 0) return null;
      const h = Math.floor(mins / 60), m = mins % 60;
      return h > 0 ? `${h}h ${m}m` : `${m}m`;
    };

    wrap.innerHTML = Object.keys(byDate).sort((a,b) => b.localeCompare(a)).map(date => {
      const dayRows  = byDate[date].slice().sort((a,b) => a.time.localeCompare(b.time)); // ASC for display
      const dayInCnt  = dayRows.filter(r => r.log_type === 'IN').length;
      const dayOutCnt = dayRows.filter(r => r.log_type === 'OUT').length;

      /* Total worked minutes from duration_minutes on OUT records (set by API) */
      const totalMins = dayRows.reduce((s,r) => s + (r.log_type==='OUT' && r.duration_minutes ? r.duration_minutes : 0), 0);
      const totalHrs  = fmtDur(totalMins);

      const dateObj = new Date(date + 'T00:00:00');
      const dayName = dateObj.toLocaleDateString('en-US', { weekday: 'short' });
      const dayFmt  = dateObj.toLocaleDateString('en-US', { weekday: 'long', month: 'short', day: 'numeric' });
      const isToday = date === today;

      return `<div style="border-bottom:1px solid var(--border)">
        <!-- Day header -->
        <div style="display:flex;align-items:center;justify-content:space-between;padding:12px 20px;background:${isToday?'rgba(99,102,241,.06)':'rgba(255,255,255,.02)'}">
          <div style="display:flex;align-items:center;gap:12px">
            <div style="width:40px;height:40px;border-radius:10px;display:flex;flex-direction:column;align-items:center;justify-content:center;
                        background:${isToday?'linear-gradient(135deg,#6366f1,#7c3aed)':'rgba(255,255,255,.06)'};
                        border:1px solid ${isToday?'rgba(99,102,241,.5)':'var(--border)'}">
              <span style="font-size:.5rem;font-weight:700;color:${isToday?'#c4b5fd':'var(--muted)'};text-transform:uppercase">${dayName}</span>
              <span style="font-size:.9rem;font-weight:900;color:${isToday?'#fff':'var(--text)'};line-height:1.2">${dateObj.getDate()}</span>
            </div>
            <div>
              <div style="font-size:.84rem;font-weight:800;color:#fff">
                ${dayFmt}
                ${isToday ? '<span style="font-size:.6rem;background:rgba(99,102,241,.2);color:#a78bfa;padding:2px 8px;border-radius:4px;border:1px solid rgba(99,102,241,.3);margin-left:6px">TODAY</span>' : ''}
              </div>
              <div style="font-size:.68rem;color:var(--muted);margin-top:2px">
                ${dayInCnt} check-in${dayInCnt!==1?'s':''} · ${dayOutCnt} check-out${dayOutCnt!==1?'s':''}
                ${totalHrs ? ' · <span style="color:#34d399;font-weight:700">'+totalHrs+' worked</span>' : ''}
              </div>
            </div>
          </div>
          <div style="display:flex;align-items:center;gap:6px">
            ${totalHrs ? `<span style="background:rgba(52,211,153,.1);border:1px solid rgba(52,211,153,.25);color:#34d399;padding:4px 10px;border-radius:8px;font-size:.7rem;font-weight:800"><i class="fas fa-clock" style="margin-right:4px"></i>${totalHrs}</span>` : ''}
            <span style="background:rgba(16,185,129,.1);border:1px solid rgba(16,185,129,.25);color:#10b981;padding:3px 8px;border-radius:6px;font-size:.65rem;font-weight:700"><i class="fas fa-sign-in-alt" style="margin-right:3px"></i>${dayInCnt}</span>
            <span style="background:rgba(244,63,94,.1);border:1px solid rgba(244,63,94,.25);color:#f87171;padding:3px 8px;border-radius:6px;font-size:.65rem;font-weight:700"><i class="fas fa-sign-out-alt" style="margin-right:3px"></i>${dayOutCnt}</span>
          </div>
        </div>

        <!-- Timeline rows -->
        <div style="position:relative">
          ${dayRows.map((r, idx) => {
            const isIn   = r.log_type === 'IN';
            const color  = isIn ? '#10b981' : '#f87171';
            const bg     = isIn ? 'rgba(16,185,129,.04)' : 'rgba(244,63,94,.04)';
            const timeStr = r.time ? r.time.substr(11, 8) : '—';
            const dur    = r.duration_minutes ? fmtDur(r.duration_minutes) : null;
            const hasGps = r.latitude && r.latitude !== 0;
            const mapUrl = hasGps ? 'https://www.google.com/maps?q=' + r.latitude + ',' + r.longitude : null;

            return `<div style="display:grid;grid-template-columns:14px 90px 70px 1fr 110px;gap:0;align-items:center;
                        padding:11px 20px 11px 16px;border-top:1px solid rgba(255,255,255,.04);background:${bg};transition:.15s"
                 onmouseover="this.style.background='rgba(255,255,255,.03)'" onmouseout="this.style.background='${bg}'">

              <!-- Timeline dot -->
              <div style="display:flex;flex-direction:column;align-items:center;gap:0">
                <div style="width:8px;height:8px;border-radius:50%;background:${color};border:2px solid ${color}44;flex-shrink:0"></div>
                ${idx < dayRows.length-1 ? '<div style="width:1px;flex:1;min-height:20px;background:var(--border);margin-top:2px"></div>' : ''}
              </div>

              <!-- Time -->
              <span style="font-size:.82rem;font-weight:800;color:#fff;font-variant-numeric:tabular-nums;padding-left:10px">${timeStr}</span>

              <!-- Type badge -->
              <span style="display:inline-flex;align-items:center;gap:4px;font-size:.66rem;font-weight:800;
                           color:${color};background:${color}12;border:1px solid ${color}30;
                           padding:3px 8px;border-radius:6px;text-transform:uppercase;letter-spacing:.3px;width:fit-content">
                <i class="fas ${isIn?'fa-sign-in-alt':'fa-sign-out-alt'}" style="font-size:.58rem"></i>${r.log_type}
              </span>

              <!-- GPS -->
              <span style="font-size:.72rem;color:var(--muted);padding:0 8px">
                ${mapUrl
                  ? '<a href="' + mapUrl + '" target="_blank" style="color:#38bdf8;text-decoration:none;display:inline-flex;align-items:center;gap:4px"><i class="fas fa-map-pin" style="color:#22d3ee;font-size:.6rem"></i>' + (+r.latitude).toFixed(5) + ', ' + (+r.longitude).toFixed(5) + '</a>'
                  : '<span style="opacity:.35"><i class="fas fa-map-pin" style="margin-right:4px;font-size:.65rem"></i>No GPS</span>'}
              </span>

              <!-- Duration (for OUT records) -->
              <span style="font-size:.72rem;text-align:right">
                ${dur
                  ? '<span style="background:rgba(52,211,153,.1);border:1px solid rgba(52,211,153,.2);color:#34d399;padding:3px 9px;border-radius:6px;font-weight:800;font-size:.68rem"><i class="fas fa-clock" style="margin-right:4px;font-size:.58rem"></i>' + dur + '</span>'
                  : isIn ? '<span style="color:var(--muted);opacity:.4;font-size:.65rem">—</span>' : '<span style="color:#f59e0b;font-size:.65rem;opacity:.7">No OUT yet</span>'}
              </span>
            </div>`;
          }).join('')}
        </div>
      </div>`;
    }).join('');

  } catch(e) {
    if (wrap) wrap.innerHTML = `<div style="padding:20px"><div class="alert a-err"><i class="fas fa-exclamation-triangle" style="margin-right:6px"></i>${esc(e.message)}</div></div>`;
    console.error('ciLoadLog error:', e);
  }
}

