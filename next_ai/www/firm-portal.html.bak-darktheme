      <th>Date</th><th>Depreciation</th><th>Accumulated</th><th>Posted</th>
    </tr></thead><tbody>${schedule.map(s=>`<tr>
      <td style="font-size:.76rem">${esc(s.schedule_date||'')}</td>
      <td style="color:#f59e0b;font-weight:700">${CUR} ${fmtN(s.depreciation_amount||0)}</td>
      <td style="color:var(--muted)">${CUR} ${fmtN(s.accumulated_depreciation_amount||0)}</td>
      <td>${s.journal_entry?`<span style="font-size:.65rem;color:#4ade80"><i class="fas fa-check"></i> Posted</span>`:`<span style="font-size:.65rem;color:var(--muted)">—</span>`}</td>
    </tr>`).join('')}</tbody></table></div>` : `<div style="color:var(--muted);font-size:.78rem;text-align:center;padding:12px">No depreciation schedule found.</div>`}`;
