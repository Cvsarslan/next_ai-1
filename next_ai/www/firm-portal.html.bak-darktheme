function ecOcrFill() {
  const data = window._lastOcrData;
  if (!data) return;

  /* Find matched expense type from global stash */
  const etypes = window._expenseTypes || [];
  const catLower = (data.category || '').toLowerCase();
  const matchedType = (window._lastOcrMatchedType) || null;

  /* Fill date */
  if (data.date) {
    const dateEl = document.getElementById('ec-date');
    if (dateEl) dateEl.value = data.date;
  }

  /* Fill remark with vendor + description */
  const rmkEl = document.getElementById('ec-rmk');
  if (rmkEl) {
    const parts = [data.vendor, data.description].filter(Boolean);
    if (parts.length) rmkEl.value = parts.join(' — ');
  }

  /* Fill first expense row (or add a new one) */
  const rows = document.querySelectorAll('[id^="ecr-"]');
  let rowId = null;
  if (rows.length > 0) {
    rowId = rows[0].id.replace('ecr-', '');
  } else {
    addExpenseRow();
    rowId = document.querySelectorAll('[id^="ecr-"]')[0]?.id.replace('ecr-', '');
  }

  if (rowId) {
    /* Set date */
    if (data.date) {
      const dEl = document.getElementById('ec-edate-' + rowId);
      if (dEl) dEl.value = data.date;
    }
    /* Set expense type */
    if (matchedType) {
      const tEl = document.getElementById('ec-etype-' + rowId);
      if (tEl) {
        for (let o of tEl.options) { if (o.value === matchedType) { o.selected = true; break; } }
      }
    }
    /* Set description */
    const descEl = document.getElementById('ec-edesc-' + rowId);
    if (descEl) descEl.value = [data.vendor, data.description].filter(Boolean).join(' — ');
    /* Set amount */
    if (data.amount) {
      const amtEl = document.getElementById('ec-eamt-' + rowId);
      if (amtEl) amtEl.value = parseFloat(data.amount).toFixed(2);
    }
  }

  /* Flash the expense row to show it was filled */
  const rowEl = document.getElementById('ecr-' + rowId);
  if (rowEl) {
    rowEl.style.transition = 'background .3s';
    rowEl.style.background = 'rgba(16,185,129,.1)';
    rowEl.style.borderRadius = '8px';
    setTimeout(() => { rowEl.style.background = ''; }, 1500);
  }

  /* Update status to confirm */
  const statusEl = document.getElementById('ec-ocr-status');
  if (statusEl) {
    const existing = statusEl.querySelector('div');
    if (existing) {
      const confirmBanner = document.createElement('div');
      confirmBanner.style.cssText = 'background:rgba(16,185,129,.1);border:1px solid rgba(16,185,129,.25);border-radius:9px;padding:8px 12px;font-size:.74rem;color:#10b981;font-weight:700;display:flex;align-items:center;gap:6px;margin-top:8px';
      confirmBanner.innerHTML = '<i class="fas fa-check-circle"></i> Fields applied — review and adjust if needed';
      statusEl.appendChild(confirmBanner);
    }
  }
}

function ecOcrClear() {
  const statusEl = document.getElementById('ec-ocr-status');
  const dropzone  = document.getElementById('ec-ocr-dropzone');
  const fileInput = document.getElementById('ec-ocr-file');
  if (statusEl) { statusEl.style.display = 'none'; statusEl.innerHTML = ''; }
  if (dropzone)  { dropzone.style.opacity = '1'; dropzone.style.pointerEvents = ''; }
  if (fileInput) fileInput.value = '';
}

function addExpenseRow() {
  const d = document.getElementById('ec-rows');
  const idx = Date.now();
  const typeOpts = (window._expenseTypes || []).map(t => `<option value="${esc(t.name)}">${esc(t.name)}</option>`).join('');
