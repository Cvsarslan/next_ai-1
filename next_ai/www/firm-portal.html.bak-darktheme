    content = `
      ${reportRowsVisual(res, col)}
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:10px">
        <div style="font-size:.72rem;color:var(--muted)">${res.rows.length} record${res.rows.length!==1?'s':''}</div>
