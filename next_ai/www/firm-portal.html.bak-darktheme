        return `<div style="background:rgba(255,255,255,.03);border:1px solid rgba(255,255,255,.07);border-radius:12px;padding:12px 14px;cursor:pointer"
          onclick="viewAsset(_assets.find(a=>a.name==='${esc(r.name)}')||${JSON.stringify({name:r.name,asset_name:r.asset_name,asset_category:r.asset_category,purchase_date:r.purchase_date,gross_purchase_amount:r.gross_purchase_amount,accumulated_depreciation_amount:r.accumulated_depreciation_amount,net_asset_value:r.net_asset_value}).replace(/"/g,'&quot;')})"
          onmouseover="this.style.borderColor='#a78bfa'" onmouseout="this.style.borderColor='rgba(255,255,255,.07)'">
          <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px">
            <div>
              <div style="font-size:.82rem;font-weight:700;color:#fff">${esc(r.asset_name)}</div>
              <div style="font-size:.65rem;color:var(--muted)">${esc(r.asset_category||'')}</div>
            </div>
            <div style="text-align:right">
              <div style="font-size:.8rem;font-weight:800;color:#f59e0b">${CUR} ${fmtN(depr)}</div>
              <div style="font-size:.62rem;color:var(--muted)">of ${CUR} ${fmtN(gross)}</div>
            </div>
          </div>
          <div style="height:6px;background:rgba(255,255,255,.06);border-radius:6px">
            <div style="height:100%;width:${pct}%;background:${pct>75?'#f87171':pct>50?'#f59e0b':'#a78bfa'};border-radius:6px;transition:width .5s"></div>
          </div>
          <div style="display:flex;justify-content:space-between;margin-top:4px">
            <span style="font-size:.62rem;color:var(--muted)">${pct}% depreciated</span>
            <span style="font-size:.62rem;color:#4ade80">Net: ${CUR} ${fmtN(r.net_asset_value||0)}</span>
          </div>
        </div>`;
      }).join('')}
