async function submitSOFollowup(salesOrder, action) {
  const btn = document.getElementById('sof-btn');
  const msg = document.getElementById('sof-msg');
  const amount = document.getElementById('sof-amount')?.value || null;
  const referenceNo = document.getElementById('sof-reference')?.value?.trim() || null;
  if (action==='advance_payment' && flt(amount)<=0) { showMsg(msg,'Enter an advance amount greater than zero.','err'); return; }
  if (action==='advance_payment' && !referenceNo) { showMsg(msg,'Bank reference number is required.','err'); return; }
  const assetAssignments = {};
  document.querySelectorAll('.sof-asset').forEach(select=>{ if(select.value) assetAssignments[select.dataset.soDetail]=select.value; });
  if ([...document.querySelectorAll('.sof-asset')].some(select=>!select.value)) { showMsg(msg,'Select an Asset for every fixed-asset item.','err'); return; }
  btn.disabled=true; btn.innerHTML='<span class="spin"></span> Creating linked draft…';
  try {
    const res = await fc('next_ai.api.create_sales_order_followup', { sales_order:salesOrder, action, amount, reference_no:referenceNo, asset_assignments:JSON.stringify(assetAssignments), posting_date:document.getElementById('sof-date').value });
    const route = res.doctype.toLowerCase().replace(/ /g,'-');
    document.getElementById('p-body').innerHTML = `<div style="text-align:center;padding:30px 10px"><div style="width:54px;height:54px;border-radius:50%;display:grid;place-items:center;background:rgba(74,222,128,.12);border:1px solid rgba(74,222,128,.3);color:#4ade80;font-size:1.3rem;margin:0 auto 12px"><i class="fas fa-check"></i></div><h4 style="color:#fff;font-size:1rem;margin-bottom:5px">${esc(res.doctype)} created</h4><div style="color:#4ade80;font-weight:800;font-size:.82rem">${esc(res.name)}</div><p style="font-size:.67rem;color:var(--muted);margin-top:8px">Linked to ${esc(salesOrder)} and saved as Draft.</p></div>`;
    document.getElementById('p-foot').innerHTML = `<button class="btn-p" onclick="window.open('/app/${route}/${encodeURIComponent(res.name)}','_blank')"><i class="fas fa-arrow-up-right-from-square"></i> Review Draft</button><button class="btn-s" onclick="viewSO('${esc(salesOrder)}')">Back to Order</button>`;
  } catch(e) {
    showMsg(msg,e.message||'Could not create linked document.','err');
    btn.disabled=false; btn.innerHTML='<i class="fas fa-arrow-right"></i> Create Draft';
  }
}

